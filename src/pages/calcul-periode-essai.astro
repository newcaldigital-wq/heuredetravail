</div>

<script is:inline>
/* ---------- Fonctions de date ---------- */
function ajouterMois(date, n){
  const d = new Date(date.getFullYear(), date.getMonth() + n, date.getDate());
  if(d.getDate() !== date.getDate()){
    return new Date(date.getFullYear(), date.getMonth() + n + 1, 0);
  }
  return d;
}
function veilleDe(date){
  const d = new Date(date);
  d.setDate(d.getDate() - 1);
  return d;
}
/* Durée en mois : expire la veille de la date anniversaire (Cass. soc. 15 mars 2006) */
function finEssaiMois(debut, nMois){
  return veilleDe(ajouterMois(debut, nMois));
}
/* Durée en jours : le jour de début compte comme jour 1 */
function finEssaiJours(debut, nJours){
  const d = new Date(debut);
  d.setDate(d.getDate() + (nJours - 1));
  return d;
}
function parseDateInput(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  return new Date(a, m-1, j);
}
function joursEntre(d1, d2){
  return Math.round((d2 - d1) / 86400000);
}
/* Projette la date à laquelle le délai de prévenance serait entièrement exécuté,
   à partir de la date de notification et du délai applicable (24h/48h/2 semaines/1 mois) */
function finTheoriqueDelai(notification, delaiLabel){
  const d = new Date(notification);
  if(delaiLabel === "24 heures"){ d.setDate(d.getDate() + 1); return d; }
  if(delaiLabel === "48 heures"){ d.setDate(d.getDate() + 2); return d; }
  if(delaiLabel === "2 semaines"){ d.setDate(d.getDate() + 14); return d; }
  if(delaiLabel === "1 mois"){ return ajouterMois(notification, 1); }
  return null;
}
function formatDateFr(d){
  const jours = ["dimanche","lundi","mardi","mercredi","jeudi","vendredi","samedi"];
  const mois = ["janvier","février","mars","avril","mai","juin","juillet","août","septembre","octobre","novembre","décembre"];
  return jours[d.getDay()] + " " + d.getDate() + " " + mois[d.getMonth()] + " " + d.getFullYear();
}

/* ---------- État de l'interface ---------- */
let typeContrat = "cdi";
let cddDureeType = "court";
let quiRompt = "employeur";

const DUREE_CDI = { ouvrier: 2, maitrise: 3, cadre: 4 };

/* ---------- Bloc 1 : durée maximale ---------- */
function calculerDureeMax(){
  let unite, dureeLegale;
  if(typeContrat === "cdi"){
    const cat = document.getElementById("categorie").value;
    if(!cat){
      return { unite: "mois", dureeLegale: null, dureeRetenue: null, conventionAppliquee: false };
    }
    const base = DUREE_CDI[cat];
    unite = "mois";
    dureeLegale = document.getElementById("renouvellement").checked ? base * 2 : base;
  } else {
    if(cddDureeType === "court"){
      unite = "jours";
      const debutCDD = parseDateInput(document.getElementById("date-debut").value);
      const finCDD = parseDateInput(document.getElementById("cdd-fin").value);
      let semaines = 0;
      if(debutCDD && finCDD && finCDD > debutCDD){
        semaines = joursEntre(debutCDD, finCDD) / 7;
      }
      dureeLegale = Math.min(Math.floor(semaines), 14);
    } else {
      unite = "mois";
      dureeLegale = 1;
    }
  }
  let dureeRetenue = dureeLegale;
  let conventionAppliquee = false;
  const convRaw = parseFloat(document.getElementById("convention").value);
  if(!isNaN(convRaw) && convRaw > 0){
    const conv = Math.round(convRaw);
    if(conv > 0 && conv < dureeLegale){
      dureeRetenue = conv;
      conventionAppliquee = true;
    }
  }
  return { unite, dureeLegale, dureeRetenue, conventionAppliquee };
}

function afficherBloc1(info){
  if(info.dureeLegale === null){
    document.getElementById("r-duree-legale").textContent = "—";
    document.getElementById("r-duree-retenue").textContent = "—";
    document.getElementById("note-convention").classList.remove("visible");
    return;
  }
  const suffixe = info.unite === "mois" ? (info.dureeLegale > 1 ? " mois" : " mois") : (info.dureeLegale > 1 ? " jours" : " jour");
  const suffixeRetenue = info.unite === "mois" ? (info.dureeRetenue > 1 ? " mois" : " mois") : (info.dureeRetenue > 1 ? " jours" : " jour");
  document.getElementById("r-duree-legale").innerHTML = info.dureeLegale + "<small>" + suffixe + "</small>";
  document.getElementById("r-duree-retenue").innerHTML = info.dureeRetenue + "<small>" + suffixeRetenue + "</small>";
  document.getElementById("convention-unite").textContent = info.unite;
  document.getElementById("note-convention").classList.toggle("visible", info.conventionAppliquee);
}

/* ---------- Bloc 2 : date de fin ---------- */
function afficherBloc2(info){
  const debutStr = document.getElementById("date-debut").value;
  const debut = parseDateInput(debutStr);
  const el = document.getElementById("r-date-fin");
  if(info.dureeLegale === null){
    el.textContent = "Complétez la catégorie professionnelle";
    el.classList.add("vide");
    return null;
  }
  if(!debut){
    el.textContent = "Renseignez une date de début";
    el.classList.add("vide");
    return null;
  }
  if(info.dureeRetenue <= 0){
    el.textContent = "Aucune période d'essai légale possible pour cette durée de contrat";
    el.classList.add("vide");
    return { debut, fin: null };
  }
  const fin = info.unite === "mois"
    ? finEssaiMois(debut, info.dureeRetenue)
    : finEssaiJours(debut, Math.round(info.dureeRetenue));
  el.textContent = formatDateFr(fin);
  el.classList.remove("vide");
  return { debut, fin };
}

/* ---------- Bloc 3 : délai de prévenance ---------- */
function afficherBloc3(info, dates){
  const pasEssai = document.getElementById("pas-essai");
  const contenu = document.getElementById("bloc3-contenu");

  if(info.dureeLegale === null){
    pasEssai.style.display = "none";
    contenu.style.display = "none";
    return;
  }
  if(info.dureeRetenue <= 0){
    pasEssai.style.display = "block";
    contenu.style.display = "none";
    return;
  }
  pasEssai.style.display = "none";
  contenu.style.display = "block";

  const el = document.getElementById("r-delai");
  const alerte = document.getElementById("alerte-courte");
  const alerteDebordement = document.getElementById("alerte-debordement");

  const dureeEnJours = info.unite === "jours" ? info.dureeRetenue : info.dureeRetenue * 30;
  alerte.classList.toggle("visible", dureeEnJours < 7);

  if(!dates){
    el.textContent = "—";
    alerteDebordement.classList.remove("visible");
    return;
  }
  const ruptureStr = document.getElementById("date-rupture").value;
  const rupture = parseDateInput(ruptureStr);
  const horsEssai = document.getElementById("alerte-hors-essai");
  if(!rupture){
    el.textContent = "—";
    alerteDebordement.classList.remove("visible");
    horsEssai.classList.remove("visible");
    return;
  }
  if(dates.fin && rupture > dates.fin){
    el.textContent = "—";
    alerteDebordement.classList.remove("visible");
    horsEssai.textContent = "⚠ La date de notification saisie (" + formatDateFr(rupture) + ") est postérieure à la fin de la période d'essai (" + formatDateFr(dates.fin) + "). Il ne s'agit alors plus d'une rupture pendant la période d'essai : le délai de prévenance ne s'applique pas. Une rupture à ce stade relève d'un autre régime juridique (licenciement pour un CDI, rupture anticipée strictement encadrée pour un CDD), non couvert par cet outil.";
    horsEssai.classList.add("visible");
    return;
  }
  if(rupture < dates.debut){
    el.textContent = "—";
    alerteDebordement.classList.remove("visible");
    horsEssai.textContent = "⚠ La date de notification saisie est antérieure à la date de début du contrat. Vérifiez les dates saisies.";
    horsEssai.classList.add("visible");
    return;
  }
  horsEssai.classList.remove("visible");
  const joursPresence = joursEntre(dates.debut, rupture);
  let delai;
  if(quiRompt === "employeur"){
    if(joursPresence < 8) delai = "24 heures";
    else if(rupture < ajouterMois(dates.debut, 1)) delai = "48 heures";
    else if(rupture < ajouterMois(dates.debut, 3)) delai = "2 semaines";
    else delai = "1 mois";
  } else {
    delai = joursPresence < 8 ? "24 heures" : "48 heures";
  }
  el.textContent = delai;

  if(dates.fin && quiRompt === "employeur"){
    const finTheorique = finTheoriqueDelai(rupture, delai);
    if(finTheorique && finTheorique > dates.fin){
      const joursIndemnite = joursEntre(dates.fin, finTheorique);
      alerteDebordement.textContent = "⚠ Ce délai déborde de la fin de la période d'essai (" + formatDateFr(dates.fin) + "). Le contrat s'arrête à cette date au plus tard — il ne peut pas être prolongé pour exécuter le délai en entier. L'employeur doit alors verser au salarié une indemnité compensatrice, équivalente à " + joursIndemnite + " jour(s) de salaire, pour la partie du délai non exécutée.";
      alerteDebordement.classList.add("visible");
    } else {
      alerteDebordement.classList.remove("visible");
    }
  } else {
    alerteDebordement.classList.remove("visible");
  }
}

/* ---------- Calcul global ---------- */
function calculerTout(){
  const info = calculerDureeMax();
  afficherBloc1(info);
  const dates = afficherBloc2(info);
  afficherBloc3(info, dates);
}

/* ---------- Câblage de l'interface ---------- */
document.querySelectorAll("#type-contrat .seg-btn").forEach(b => b.addEventListener("click", () => {
  typeContrat = b.dataset.type;
  document.querySelectorAll("#type-contrat .seg-btn").forEach(x => x.classList.toggle("active", x === b));
  document.getElementById("bloc-cdi").style.display = typeContrat === "cdi" ? "flex" : "none";
  document.getElementById("renouvellement-wrap").style.display = typeContrat === "cdi" ? "flex" : "none";
  document.getElementById("hint-renouvellement").style.display = typeContrat === "cdi" ? "block" : "none";
  document.getElementById("bloc-cdd").style.display = typeContrat === "cdd" ? "block" : "none";
  calculerTout();
}));

document.querySelectorAll("#cdd-duree .seg-btn").forEach(b => b.addEventListener("click", () => {
  cddDureeType = b.dataset.duree;
  document.querySelectorAll("#cdd-duree .seg-btn").forEach(x => x.classList.toggle("active", x === b));
  document.getElementById("cdd-semaines-wrap").style.display = cddDureeType === "court" ? "flex" : "none";
  calculerTout();
}));

document.querySelectorAll("#qui-rompt .seg-btn").forEach(b => b.addEventListener("click", () => {
  quiRompt = b.dataset.qui;
  document.querySelectorAll("#qui-rompt .seg-btn").forEach(x => x.classList.toggle("active", x === b));
  calculerTout();
}));

document.getElementById("categorie").addEventListener("change", calculerTout);
document.getElementById("renouvellement").addEventListener("change", calculerTout);
document.getElementById("cdd-fin").addEventListener("change", calculerTout);
document.getElementById("convention").addEventListener("input", calculerTout);
document.getElementById("date-debut").addEventListener("change", calculerTout);
document.getElementById("date-rupture").addEventListener("change", calculerTout);

/* Réglages initiaux : masquer le bloc CDD, afficher hint CDI */
document.getElementById("bloc-cdd").style.display = "none";

calculerTout();
</script>
</body>
</html>
