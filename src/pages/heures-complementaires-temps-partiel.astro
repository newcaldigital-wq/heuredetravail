<script is:inline>
const SEUIL_LEGAL=35;
const SEUIL_LEGAL_MENSUEL=151.67;
let MODE="semaine";
const TXT_ALERTE_SEMAINE="⚠ Au moins une semaine de ce mois atteint 35 h. Les heures complémentaires ne peuvent pas porter la durée du travail au niveau de la durée légale du temps complet (35 h) ou, si elle est inférieure, au niveau de la durée conventionnelle applicable — le dépassement peut alors entraîner une requalification du contrat. Cette alerte se base sur 35 h à titre indicatif : vérifiez le seuil réel applicable à votre situation avec un professionnel.";
const TXT_ALERTE_MOIS="⚠ Le cumul de ce mois atteint 151,67 h — l'équivalent mensuel de la durée légale du temps complet. Les heures complémentaires ne peuvent pas porter la durée du travail à ce niveau (ou à la durée conventionnelle applicable si elle est inférieure) — le dépassement peut alors entraîner une requalification du contrat. Cette alerte se base sur 151,67 h à titre indicatif : vérifiez le seuil réel applicable à votre situation avec un professionnel.";

function tvd(v){if(v==null||v==="")return NaN;const s=String(v).trim().replace(",",".");const m=s.match(/^(\d{1,2})\s*[:hH]\s*(\d{1,2})$/);if(m)return +m[1]+(+m[2])/60;const d=parseFloat(s);return isNaN(d)?NaN:d;}
function hJour(a1,a2,p1,p2){let t=0;const x1=tvd(a1),x2=tvd(a2);if(!isNaN(x1)&&!isNaN(x2))t+=Math.max(0,x2-x1);const y1=tvd(p1),y2=tvd(p2);if(!isNaN(y1)&&!isNaN(y2))t+=Math.max(0,y2-y1);return t;}
function decHM(d){if(isNaN(d))return"";let h=Math.floor(d+1e-9),m=Math.round((d-h)*60);if(m===60){h++;m=0;}return h+"h"+String(m).padStart(2,"0");}
function decFr(d){return d.toFixed(2).replace(".",",");}
function isoSem(dt){const d=new Date(Date.UTC(dt.getFullYear(),dt.getMonth(),dt.getDate()));const j=d.getUTCDay()||7;d.setUTCDate(d.getUTCDate()+4-j);const y=new Date(Date.UTC(d.getUTCFullYear(),0,1));return Math.ceil(((d-y)/86400000+1)/7);}
function cleJour(dt){return dt.getFullYear()+"-"+String(dt.getMonth()+1).padStart(2,"0")+"-"+String(dt.getDate()).padStart(2,"0");}
function lundiDe(dt){const d=new Date(dt);const j=(d.getDay()+6)%7;d.setDate(d.getDate()-j);d.setHours(0,0,0,0);return d;}
function dimancheDe(dt){const l=lundiDe(dt);const d=new Date(l);d.setDate(l.getDate()+6);return d;}

const DATA={};

function contratActuel(){
  const sel=document.getElementById("contrat").value;
  if(sel==="autre"){const v=parseFloat(document.getElementById("contrat-libre").value);return isNaN(v)?20:v;}
  return parseFloat(sel);
}
function contratMensuelActuel(){
  const v=parseFloat(document.getElementById("contrat-mensuel").value);
  return isNaN(v)?0:v;
}

/* Heures complémentaires d'une semaine (lundi->dimanche), rattachées au mois du dimanche */
function semaineInfo(lundi,contrat){
  let cumul=0;
  for(let i=0;i<7;i++){
    const d=new Date(lundi);d.setDate(lundi.getDate()+i);
    const rec=DATA[cleJour(d)]||{};cumul+=hJour(rec.am1,rec.am2,rec.pm1,rec.pm2);
  }
  const comp=Math.max(0,cumul-contrat);
  const alerte=cumul>=SEUIL_LEGAL;
  const dim=new Date(lundi);dim.setDate(lundi.getDate()+6);
  return {comp,alerte,moisFin:dim.getFullYear()+"-"+String(dim.getMonth()+1).padStart(2,"0")};
}

/* Total du mois : heures complémentaires des semaines qui se terminent dans le mois + drapeau alerte */
function calcMois(annee,mois,contrat){
  const premier=new Date(annee,mois,1),dernier=new Date(annee,mois+1,0);
  let l=lundiDe(premier);const fin=lundiDe(dernier);
  let comp=0,alerte=false;const cle=annee+"-"+String(mois+1).padStart(2,"0");
  while(l<=fin){const s=semaineInfo(l,contrat);if(s.moisFin===cle){comp+=s.comp;if(s.alerte)alerte=true;}const nx=new Date(l);nx.setDate(l.getDate()+7);l=nx;}
  const base=contrat*52/12;
  return {base,comp,alerte};
}

/* Map des lundis en alerte (>=35h), pour marquer les lignes de la grille affichée */
function semainesAlerte(annee,mois,contrat){
  const premier=new Date(annee,mois,1),dernier=new Date(annee,mois+1,0);
  const lun1=lundiDe(premier),dim=dimancheDe(dernier);
  const map={};
  for(let l=new Date(lun1);l<=dim;l.setDate(l.getDate()+7)){
    let cumul=0;
    for(let i=0;i<7;i++){const d=new Date(l);d.setDate(l.getDate()+i);const rec=DATA[cleJour(d)]||{};cumul+=hJour(rec.am1,rec.am2,rec.pm1,rec.pm2);}
    map[cleJour(l)]=cumul>=SEUIL_LEGAL;
  }
  return map;
}

/* Mode mensuel : chaque jour reste rattaché au mois civil affiché, pas de semaine à cheval */
function calcMoisMensuel(annee,mois,contratM){
  const dernier=new Date(annee,mois+1,0);
  let total=0;
  for(let d=1;d<=dernier.getDate();d++){
    const dt=new Date(annee,mois,d);
    const rec=DATA[cleJour(dt)]||{};
    total+=hJour(rec.am1,rec.am2,rec.pm1,rec.pm2);
  }
  const comp=Math.max(0,total-contratM);
  const alerte=total>=SEUIL_LEGAL_MENSUEL;
  return {base:contratM,comp,alerte};
}

const MOIS=["Janvier","Février","Mars","Avril","Mai","Juin","Juillet","Août","Septembre","Octobre","Novembre","Décembre"];
const JOURS=["lun","mar","mer","jeu","ven","sam","dim"];
const selMois=document.getElementById("mois");
MOIS.forEach((m,i)=>{const o=document.createElement("option");o.value=i;o.textContent=m;selMois.appendChild(o);});
const now=new Date();selMois.value=now.getMonth();document.getElementById("annee").value=now.getFullYear();

function sauveLigne(tr){
  const k=tr.dataset.date;
  DATA[k]={am1:tr.querySelector(".am1").value,am2:tr.querySelector(".am2").value,pm1:tr.querySelector(".pm1").value,pm2:tr.querySelector(".pm2").value};
  const h=hJour(DATA[k].am1,DATA[k].am2,DATA[k].pm1,DATA[k].pm2);
  tr.querySelector("[data-h]").textContent=h>0?decHM(h):"—";
  if(MODE==="semaine")construireAlertes();
  calculer();
}
function ligneHTML(date,report,alertesMap){
  const jw=(date.getDay()+6)%7,sem=isoSem(date),k=cleJour(date),rec=DATA[k]||{},h=hJour(rec.am1,rec.am2,rec.pm1,rec.pm2);
  const cls=[report?"report":"",jw>=5?"we":""].filter(Boolean).join(" ");
  let semCell="";
  if(jw===0&&MODE==="semaine"){
    const lundiKey=cleJour(lundiDe(date));
    const alerte=alertesMap&&alertesMap[lundiKey];
    semCell='<span class="semlabel'+(alerte?" semalerte":"")+'">'+sem+(alerte?' <span class="semalerte-icone">⚠</span>':"")+'</span>';
  }
  return '<tr class="'+cls+'" data-date="'+k+'">'
    +'<td class="col-sem">'+semCell+'</td>'
    +'<td class="date">'+String(date.getDate()).padStart(2,"0")+"/"+String(date.getMonth()+1).padStart(2,"0")+'</td>'
    +'<td class="jour">'+JOURS[jw]+'</td>'
    +'<td><input type="time" class="am1" value="'+(rec.am1||"")+'"></td>'
    +'<td><input type="time" class="am2" value="'+(rec.am2||"")+'"></td>'
    +'<td><input type="time" class="pm1" value="'+(rec.pm1||"")+'"></td>'
    +'<td><input type="time" class="pm2" value="'+(rec.pm2||"")+'"></td>'
    +'<td class="htot" data-h>'+(h>0?decHM(h):"—")+'</td></tr>';
}
function construireSemaine(){
  const mois=+selMois.value,annee=+document.getElementById("annee").value,contrat=contratActuel();
  const premier=new Date(annee,mois,1),dernier=new Date(annee,mois+1,0);
  const alertesMap=semainesAlerte(annee,mois,contrat);
  let html="";
  const lun1=lundiDe(premier);
  for(let d=new Date(lun1);d<premier;d.setDate(d.getDate()+1))html+=ligneHTML(new Date(d),true,alertesMap);
  for(let d=1;d<=dernier.getDate();d++)html+=ligneHTML(new Date(annee,mois,d),false,alertesMap);
  const dim=dimancheDe(dernier);
  for(let d=new Date(dernier.getTime()+86400000);d<=dim;d.setDate(d.getDate()+1))html+=ligneHTML(new Date(d),true,alertesMap);
  const corps=document.getElementById("corps");corps.innerHTML=html;
  corps.querySelectorAll("input").forEach(inp=>{
    inp.addEventListener("input",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("change",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("blur",()=>sauveLigne(inp.closest("tr")));
  });
}
function construireMois(){
  const mois=+selMois.value,annee=+document.getElementById("annee").value;
  const dernier=new Date(annee,mois+1,0);
  let html="";
  for(let d=1;d<=dernier.getDate();d++)html+=ligneHTML(new Date(annee,mois,d),false,null);
  const corps=document.getElementById("corps");corps.innerHTML=html;
  corps.querySelectorAll("input").forEach(inp=>{
    inp.addEventListener("input",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("change",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("blur",()=>sauveLigne(inp.closest("tr")));
  });
}
function construire(){
  if(MODE==="semaine")construireSemaine();else construireMois();
}
function construireAlertes(){
  const mois=+selMois.value,annee=+document.getElementById("annee").value,contrat=contratActuel();
  const alertesMap=semainesAlerte(annee,mois,contrat);
  document.querySelectorAll("#corps tr").forEach(tr=>{
    const d=new Date(tr.dataset.date);
    const jw=(d.getDay()+6)%7;
    if(jw===0){
      const lundiKey=cleJour(lundiDe(d));
      const alerte=alertesMap[lundiKey];
      const sem=isoSem(d);
      const cell=tr.children[0];
      cell.innerHTML='<span class="semlabel'+(alerte?" semalerte":"")+'">'+sem+(alerte?' <span class="semalerte-icone">⚠</span>':"")+'</span>';
    }
  });
}
function calculer(){
  const r = MODE==="semaine"
    ? calcMois(+document.getElementById("annee").value,+selMois.value,contratActuel())
    : calcMoisMensuel(+document.getElementById("annee").value,+selMois.value,contratMensuelActuel());
  document.getElementById("r-base").innerHTML=decFr(r.base)+'<small> h</small>';
  document.getElementById("r-comp").innerHTML=decFr(r.comp)+'<small> h · '+decHM(r.comp)+'</small>';
  document.getElementById("alerte-35").innerHTML = MODE==="semaine" ? TXT_ALERTE_SEMAINE : TXT_ALERTE_MOIS;
  document.getElementById("alerte-35").classList.toggle("visible",r.alerte);
}
function exemple(){
  const mois=+selMois.value,annee=+document.getElementById("annee").value,nb=new Date(annee,mois+1,0).getDate();
  for(let d=1;d<=nb;d++){const dt=new Date(annee,mois,d),jw=(dt.getDay()+6)%7;if(jw<5)DATA[cleJour(dt)]={am1:"09:00",am2:"12:00",pm1:"13:00",pm2:"17:00"};}
  construire();calculer();
}
function vider(){
  const mois=+selMois.value,annee=+document.getElementById("annee").value,nb=new Date(annee,mois+1,0).getDate();
  for(let d=1;d<=nb;d++)delete DATA[cleJour(new Date(annee,mois,d))];
  construire();calculer();
}
function changeMois(delta){
  let m=+selMois.value+delta,y=+document.getElementById("annee").value;
  if(m<0){m=11;y--;}else if(m>11){m=0;y++;}
  selMois.value=m;document.getElementById("annee").value=y;construire();calculer();
}
function setMode(m){
  MODE=m;
  document.querySelectorAll(".seg-btn").forEach(b=>b.classList.toggle("active",b.dataset.mode===m));
  document.getElementById("contrat-semaine").style.display=m==="semaine"?"flex":"none";
  document.getElementById("contrat-mois").style.display=m==="mois"?"flex":"none";
  document.getElementById("hint-mois").style.display=m==="mois"?"block":"none";
  document.getElementById("grille").classList.toggle("mode-mois",m==="mois");
  document.getElementById("cadre-legal").innerHTML = m==="semaine"
    ? 'Décompte à la semaine civile, selon votre durée contractuelle &middot; alerte si une semaine atteint <b>35 h</b> (seuil légal du temps complet)'
    : 'Décompte au mois civil, selon votre durée contractuelle mensuelle &middot; alerte si le cumul du mois atteint <b>151,67 h</b> (équivalent mensuel du temps complet)';
  document.getElementById("hint-horaires").innerHTML = m==="semaine"
    ? 'Laissez vide un jour non travaillé. La pause du midi est déduite automatiquement. Les lignes <span style="color:var(--report-b);font-weight:600">violettes</span> appartiennent au mois voisin&nbsp;: elles servent à calculer correctement le seuil des semaines à cheval. Une semaine marquée <span style="color:var(--alerte);font-weight:600">⚠</span> atteint 35 h.'
    : 'Laissez vide un jour non travaillé. La pause du midi est déduite automatiquement. Chaque heure reste rattachée au jour réellement travaillé dans ce mois civil.';
  construire();calculer();
}
document.querySelectorAll(".seg-btn").forEach(b=>b.addEventListener("click",()=>setMode(b.dataset.mode)));
document.getElementById("contrat-mensuel").addEventListener("input",()=>calculer());
document.getElementById("contrat").addEventListener("change",function(){
  document.getElementById("contrat-libre").style.display=this.value==="autre"?"inline-block":"none";
  construire();calculer();
});
document.getElementById("contrat-libre").addEventListener("input",()=>{construire();calculer();});
selMois.addEventListener("change",()=>{construire();calculer();});
document.getElementById("annee").addEventListener("change",()=>{construire();calculer();});
document.getElementById("prev").addEventListener("click",()=>changeMois(-1));
document.getElementById("next").addEventListener("click",()=>changeMois(1));
document.getElementById("calculer").addEventListener("click",calculer);
document.getElementById("exemple").addEventListener("click",exemple);
document.getElementById("vider").addEventListener("click",vider);
construire();calculer();
</script>
</body>
</html>
