<script is:inline>
/* Ajoute n mois à une date, en plafonnant sur le dernier jour du mois cible
   si le jour d'origine n'existe pas (ex: 31 janvier + 1 mois -> 28/29 février,
   pas "3 mars" comme le ferait un objet Date natif). */
function ajouterMois(date, n){
  const d = new Date(date.getFullYear(), date.getMonth() + n, date.getDate());
  if(d.getDate() !== date.getDate()){
    return new Date(date.getFullYear(), date.getMonth() + n + 1, 0);
  }
  return d;
}

/* Calcule la durée exacte en années/mois/jours entre deux dates.
   Méthode robuste (par ajout de mois plafonné) : gère correctement les
   dates de fin de mois (31, 29 février) sans jamais produire de jours négatifs. */
function diffDates(debut, fin){
  const approx = (fin.getFullYear() - debut.getFullYear()) * 12 + (fin.getMonth() - debut.getMonth());
  let totalMois = approx;
  let candidat = ajouterMois(debut, totalMois);
  if(candidat > fin){
    totalMois -= 1;
    candidat = ajouterMois(debut, totalMois);
  } else {
    let suivant = ajouterMois(debut, totalMois + 1);
    while(suivant <= fin){
      totalMois += 1;
      candidat = suivant;
      suivant = ajouterMois(debut, totalMois + 1);
    }
  }
  const jours = Math.round((fin - candidat) / 86400000);
  const annees = Math.floor(totalMois / 12);
  const mois = totalMois % 12;
  const totalJours = Math.round((fin - debut) / 86400000);
  return {annees, mois, jours, totalJours};
}

function parseDate(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  return new Date(a, m-1, j);
}

function formatDuree(r){
  const parts = [];
  parts.push(r.annees + (r.annees === 1 ? " an" : " ans"));
  parts.push(r.mois + (r.mois === 1 ? " mois" : " mois"));
  parts.push(r.jours + (r.jours === 1 ? " jour" : " jours"));
  return parts.join(", ");
}

const MSG_ORDRE = "La date de calcul doit être postérieure ou égale à la date d'entrée.";
const MSG_INVALIDE = "Date invalide : vérifiez que le jour saisi existe bien dans le mois choisi (par exemple, il n'y a pas de 30 février).";

function calculer(){
  const inpDebut = document.getElementById("date-entree");
  const inpFin = document.getElementById("date-calcul");
  const erreur = document.getElementById("erreur-dates");

  /* badInput = true quand le navigateur a reçu une saisie qu'il ne peut pas
     convertir en date valide (ex: 30 février) : le champ reste vide en interne
     même si du texte est encore visible à l'écran. On distingue ce cas d'une
     simple date manquante pour donner un message utile plutôt qu'un silence. */
  if(inpDebut.validity.badInput || inpFin.validity.badInput){
    erreur.textContent = MSG_INVALIDE;
    erreur.classList.add("visible");
    document.getElementById("r-principal").textContent = "—";
    document.getElementById("r-jours").textContent = "—";
    return;
  }

  const debut = parseDate(inpDebut.value);
  const fin = parseDate(inpFin.value);
  const noteJour = document.getElementById("note-dernier-jour");
  noteJour.classList.remove("visible");

  if(!debut || !fin){
    document.getElementById("r-principal").textContent = "—";
    document.getElementById("r-jours").textContent = "—";
    erreur.classList.remove("visible");
    return;
  }
  if(fin < debut){
    erreur.textContent = MSG_ORDRE;
    erreur.classList.add("visible");
    document.getElementById("r-principal").textContent = "—";
    document.getElementById("r-jours").textContent = "—";
    return;
  }
  erreur.classList.remove("visible");
  /* Date de fin de contrat : le dernier jour travaillé compte, l'ancienneté court donc
     jusqu'au lendemain (ex. entrée 01/01/2025, fin 31/08/2025 → 8 mois). Sans la case,
     la date saisie est une date de référence : seuls les jours déjà écoulés comptent
     (entrée 01/01, au 30/06 → 5 mois 29 jours ; 6 mois le 01/07). */
  let finCalcul = fin;
  if(document.getElementById("dernier-jour").checked){
    finCalcul = new Date(fin.getFullYear(), fin.getMonth(), fin.getDate() + 1);
    noteJour.textContent = "Le dernier jour du contrat est compté : l'ancienneté est calculée jusqu'à la fin de cette journée, soit l'équivalent d'un calcul au lendemain.";
    noteJour.classList.add("visible");
  }
  const r = diffDates(debut, finCalcul);
  document.getElementById("r-principal").textContent = formatDuree(r);
  document.getElementById("r-jours").innerHTML = r.totalJours + (r.totalJours === 1 ? "<small> jour</small>" : "<small> jours</small>");
}

function ajdISO(){
  const d = new Date();
  return d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0");
}

document.getElementById("date-entree").addEventListener("change", calculer);
document.getElementById("date-calcul").addEventListener("change", calculer);
document.getElementById("date-entree").addEventListener("input", calculer);
document.getElementById("date-calcul").addEventListener("input", calculer);
document.getElementById("dernier-jour").addEventListener("change", calculer);
document.getElementById("aujourdhui").addEventListener("click", ()=>{
  document.getElementById("date-calcul").value = ajdISO();
  calculer();
});
document.getElementById("vider").addEventListener("click", ()=>{
  document.getElementById("date-entree").value = "";
  document.getElementById("date-calcul").value = "";
  calculer();
});

document.getElementById("date-calcul").value = ajdISO();
</script>
</body>
</html>
