<script is:inline>
/* Toutes les dates sont manipulées en UTC (minuit UTC) : aucun effet du
   fuseau horaire ni des changements d'heure du navigateur sur le décompte.
   Moteur de jours fériés repris de la page jours ouvrés (validée le
   17/10/2026) ; seule la logique de calcul des RTT est propre à cette page. */

function dateU(annee, moisIndex, jour){
  return new Date(Date.UTC(annee, moisIndex, jour));
}

/* Calcule la date de Pâques (dimanche) pour une année donnée.
   Algorithme de Gauss / méthode anonyme grégorienne. */
function datePaques(annee){
  const a = annee % 19;
  const b = Math.floor(annee / 100);
  const c = annee % 100;
  const d = Math.floor(b / 4);
  const e = b % 4;
  const f = Math.floor((b + 8) / 25);
  const g = Math.floor((b - f + 1) / 3);
  const h = (19*a + b - d - g + 15) % 30;
  const i = Math.floor(c / 4);
  const k = c % 4;
  const l = (32 + 2*e + 2*i - h - k) % 7;
  const m = Math.floor((a + 11*h + 22*l) / 451);
  const val = h + l - 7*m + 114;
  const mois = Math.floor(val / 31); // 3 = mars, 4 = avril
  const jour = (val % 31) + 1;
  return dateU(annee, mois - 1, jour);
}

function ajouterJours(date, n){
  const d = new Date(date.getTime());
  d.setUTCDate(d.getUTCDate() + n);
  return d;
}

function iso(d){
  return d.getUTCFullYear() + "-" + String(d.getUTCMonth()+1).padStart(2,"0") + "-" + String(d.getUTCDate()).padStart(2,"0");
}

const MS_JOUR = 86400000;

/* Jours fériés légaux nationaux (Code du travail, art. L3133-1). */
const FERIES_NATIONAUX = [
  {cle:"jour_an",        libelle:"Jour de l'an (1er janvier)",        calc:(a,p)=> dateU(a,0,1)},
  {cle:"lundi_paques",   libelle:"Lundi de Pâques",                   calc:(a,p)=> ajouterJours(p,1)},
  {cle:"fete_travail",   libelle:"Fête du travail (1er mai)",         calc:(a,p)=> dateU(a,4,1)},
  {cle:"victoire_1945",  libelle:"Victoire 1945 (8 mai)",             calc:(a,p)=> dateU(a,4,8)},
  {cle:"ascension",      libelle:"Ascension",                        calc:(a,p)=> ajouterJours(p,39)},
  {cle:"pentecote",      libelle:"Lundi de Pentecôte",                calc:(a,p)=> ajouterJours(p,50)},
  {cle:"fete_nationale", libelle:"Fête nationale (14 juillet)",       calc:(a,p)=> dateU(a,6,14)},
  {cle:"assomption",     libelle:"Assomption (15 août)",              calc:(a,p)=> dateU(a,7,15)},
  {cle:"toussaint",      libelle:"Toussaint (1er novembre)",          calc:(a,p)=> dateU(a,10,1)},
  {cle:"armistice",      libelle:"Armistice 1918 (11 novembre)",      calc:(a,p)=> dateU(a,10,11)},
  {cle:"noel",           libelle:"Noël (25 décembre)",                calc:(a,p)=> dateU(a,11,25)}
];

/* Jours fériés supplémentaires du régime local Alsace-Moselle (art. L3134-13),
   ajoutés uniquement si l'option est cochée. Le Vendredi saint n'est férié que
   dans les communes ayant un temple protestant ou une église mixte. */
const FERIES_ALSACE_MOSELLE = [
  {cle:"vendredi_saint", libelle:"Vendredi saint (Alsace-Moselle, communes avec temple protestant ou église mixte)", calc:(a,p)=> ajouterJours(p,-2)},
  {cle:"saint_etienne",  libelle:"Saint-Étienne, 26 décembre (Alsace-Moselle)", calc:(a,p)=> dateU(a,11,26)}
];

/* Carte "date ISO -> liste des clés de jours fériés". Une liste, et non une
   clé unique : deux fériés peuvent tomber le même jour (Ascension = 1er mai
   en 2008 ; Ascension = 8 mai en 2059, 2070, 2081, 2092…). */
function carteFeries(anneeDebut, anneeFin, alsaceMoselle){
  const defs = alsaceMoselle ? FERIES_NATIONAUX.concat(FERIES_ALSACE_MOSELLE) : FERIES_NATIONAUX;
  const carte = new Map();
  for(let y = anneeDebut; y <= anneeFin; y++){
    const paques = datePaques(y);
    defs.forEach(def => {
      const k = iso(def.calc(y, paques));
      if(!carte.has(k)) carte.set(k, []);
      carte.get(k).push(def.cle);
    });
  }
  return carte;
}

/* Définitions de jours fériés dont au moins une occurrence tombe dans la
   période [debut, fin], dans l'ordre du calendrier légal. */
function feriesPresents(debut, fin, alsaceMoselle){
  const defs = alsaceMoselle ? FERIES_NATIONAUX.concat(FERIES_ALSACE_MOSELLE) : FERIES_NATIONAUX;
  const presents = [];
  for(let y = debut.getUTCFullYear(); y <= fin.getUTCFullYear(); y++){
    const paques = datePaques(y);
    defs.forEach(def => {
      const d = def.calc(y, paques);
      if(d >= debut && d <= fin && !presents.some(p => p.cle === def.cle)){
        presents.push({cle: def.cle, libelle: def.libelle, date: d});
      }
    });
  }
  return presents;
}

/* Un jour férié est chômé selon le profil. En mode personnalisé, si plusieurs
   fériés tombent le même jour, il suffit que l'un d'eux soit coché. */
function estExclu(cles, profil, etat){
  if(cles.length === 0) return false;
  if(profil === "tous") return true;
  if(profil === "aucun") return false;
  return cles.some(c => etat[c] !== false);
}

function formatDateFr(d){
  return d.toLocaleDateString("fr-FR", {weekday:"long", day:"numeric", month:"long", year:"numeric", timeZone:"UTC"});
}

const ANNEE_MIN = 1900, ANNEE_MAX = 2100;

function parseDate(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  if(!a || !m || !j) return null;
  const d = dateU(a, m-1, j);
  d.setUTCFullYear(a); // évite l'interprétation 0050 -> 1950
  return d;
}

function anneeHorsBornes(d){
  return d && (d.getUTCFullYear() < ANNEE_MIN || d.getUTCFullYear() > ANNEE_MAX);
}

/* Lendemain du dernier jour d'une période de 12 mois commençant à "debut"
   (même quantième l'année suivante ; 29 février -> 1er mars). */
function anniversaire(debut){
  return dateU(debut.getUTCFullYear() + 1, debut.getUTCMonth(), debut.getUTCDate());
}

/* Parcourt la période jour par jour : jours calendaires, week-ends et jours
   fériés chômés tombant un jour normalement travaillé (lun-ven). */
function compterPeriode(debut, fin, alsaceMoselle, profil, etat){
  const carte = carteFeries(debut.getUTCFullYear(), fin.getUTCFullYear(), alsaceMoselle);
  let jCalendaires = 0, jWeekend = 0, jFeries = 0;
  let cur = new Date(debut.getTime());
  while(cur <= fin){
    jCalendaires++;
    const dow = cur.getUTCDay(); // 0 = dimanche, 6 = samedi
    const estWeekend = (dow === 0 || dow === 6);
    if(estWeekend) jWeekend++;
    else if(estExclu(carte.get(iso(cur)) || [], profil, etat)) jFeries++;
    cur = ajouterJours(cur, 1);
  }
  return {jCalendaires, jWeekend, jFeries};
}

const MSG_ORDRE = "La date de fin doit être postérieure ou égale à la date de début.";
const MSG_INVALIDE = "Date invalide : vérifiez que le jour saisi existe bien dans le mois choisi.";
const MSG_BORNES = "Saisissez des dates comprises entre 1900 et 2100.";
const MSG_ANNEE_VIDE = "Saisissez l'année de référence.";
const MSG_ANNEE_BORNES = "Saisissez une année comprise entre 1900 et 2100.";
const MSG_12_MOIS = "La période ne peut pas dépasser 12 mois. Pour une année civile entière, choisissez « Année complète ».";
const MSG_DUREE_NULLE = "Saisissez une durée hebdomadaire supérieure à 0.";
const MSG_DUREE_MAX = "Au-delà de 48h au cours d'une même semaine, la durée dépasse le maximum légal (art. L3121-20) : vérifiez la saisie.";
const MSG_SOUS_35 = "En dessous de 35h, l'horaire ne génère pas de RTT. Un salarié à temps partiel ne bénéficie pas en principe de jours de RTT, sauf accord le prévoyant.";

/* Mémorise, par clé de jour férié, si l'utilisateur l'a décoché en mode
   personnalisé. Absent de cet objet = coché (comportement par défaut). */
const etatPersonnalise = {};

function rendreListePersonnalisee(debut, fin, alsaceMoselle){
  const conteneur = document.getElementById("liste-personnalisee");
  const presents = feriesPresents(debut, fin, alsaceMoselle);
  if(presents.length === 0){
    conteneur.innerHTML = '<div class="msg-vide">Aucun jour férié sur cette période.</div>';
    return;
  }
  conteneur.innerHTML = presents.map(def => {
    const coche = etatPersonnalise[def.cle] === false ? "" : "checked";
    return '<div class="item-ferie"><input type="checkbox" id="fer-' + def.cle + '" data-cle="' + def.cle + '" ' + coche + '><label for="fer-' + def.cle + '">' + def.libelle + ' — <span style="color:var(--gris)">' + formatDateFr(def.date) + '</span></label></div>';
  }).join("");
}

function afficherVide(){
  ["r-rtt","r-heures-rtt","r-semaines","r-feries","r-cp"].forEach(id=>{
    document.getElementById(id).textContent = "—";
  });
  document.getElementById("r-cp-note").textContent = "";
}

function montrerErreur(msg){
  const e = document.getElementById("erreur-msg");
  e.textContent = msg;
  e.classList.add("visible");
}

function montrerInfo(msg){
  const e = document.getElementById("info-msg");
  e.textContent = msg;
  e.classList.add("visible");
}

/* Liste personnalisée en mode "message d'attente" quand la période n'est pas
   encore exploitable, au lieu d'un contenu obsolète. */
function listeEnAttente(profil, message){
  const conteneur = document.getElementById("liste-personnalisee");
  if(profil === "personnalise"){
    conteneur.style.display = "block";
    conteneur.innerHTML = '<div class="msg-vide">' + message + '</div>';
  } else {
    conteneur.style.display = "none";
    conteneur.innerHTML = "";
  }
}

function basculerBlocs(){
  const type = document.getElementById("type-periode").value;
  document.getElementById("bloc-complete").style.display = (type === "complete") ? "block" : "none";
  document.getElementById("bloc-incomplete").style.display = (type === "incomplete") ? "block" : "none";
}

function arrondi1(n){
  return Math.round(n * 10) / 10;
}

function fmt(n){
  return String(arrondi1(n));
}

/* Arrête le calcul avec un message d'erreur sur la période. */
function stopPeriode(profil, msgErreur, msgListe){
  if(msgErreur) montrerErreur(msgErreur);
  listeEnAttente(profil, msgListe);
  afficherVide();
}

function calculer(){
  document.getElementById("erreur-msg").classList.remove("visible");
  document.getElementById("info-msg").classList.remove("visible");

  const modeCP = document.getElementById("mode-cp").value;
  const typePeriode = document.getElementById("type-periode").value;
  const alsaceMoselle = document.getElementById("alsace-moselle").checked;
  const profil = document.getElementById("profil-feries").value;

  if(!typePeriode){
    stopPeriode(profil, null, "Choisissez d'abord un type de période ci-dessus pour afficher la liste des jours fériés.");
    return;
  }

  let debut, fin, joursReference = null;

  if(typePeriode === "complete"){
    const inpAnnee = document.getElementById("annee-ref");
    if(inpAnnee.value.trim() === "" || inpAnnee.validity.badInput){
      stopPeriode(profil, MSG_ANNEE_VIDE, "Saisissez l'année de référence pour afficher la liste des jours fériés.");
      return;
    }
    const annee = parseInt(inpAnnee.value, 10);
    if(isNaN(annee) || annee < ANNEE_MIN || annee > ANNEE_MAX){
      stopPeriode(profil, MSG_ANNEE_BORNES, "Corrigez l'année pour afficher la liste des jours fériés.");
      return;
    }
    debut = dateU(annee, 0, 1);
    fin = dateU(annee, 11, 31);
  } else {
    const inpDebut = document.getElementById("date-debut");
    const inpFin = document.getElementById("date-fin");

    if(inpDebut.validity.badInput || inpFin.validity.badInput){
      stopPeriode(profil, MSG_INVALIDE, "Corrigez la date invalide pour afficher la liste des jours fériés.");
      return;
    }
    debut = parseDate(inpDebut.value);
    fin = parseDate(inpFin.value);
    if(!debut || !fin){
      stopPeriode(profil, null, "Renseignez une date de début et une date de fin pour afficher la liste des jours fériés.");
      return;
    }
    if(anneeHorsBornes(debut) || anneeHorsBornes(fin)){
      stopPeriode(profil, MSG_BORNES, "Corrigez les dates pour afficher la liste des jours fériés.");
      return;
    }
    if(fin < debut){
      stopPeriode(profil, MSG_ORDRE, "Corrigez l'ordre des dates pour afficher la liste des jours fériés.");
      return;
    }
    const anniv = anniversaire(debut);
    if(fin >= anniv){
      stopPeriode(profil, MSG_12_MOIS, "Ramenez la période à 12 mois au plus pour afficher la liste des jours fériés.");
      return;
    }
    /* Prorata des CP sur les 12 mois qui suivent la date de début. */
    joursReference = Math.round((anniv.getTime() - debut.getTime()) / MS_JOUR);
  }

  const conteneurListe = document.getElementById("liste-personnalisee");
  conteneurListe.style.display = (profil === "personnalise") ? "block" : "none";
  if(profil === "personnalise") rendreListePersonnalisee(debut, fin, alsaceMoselle);

  const {jCalendaires, jWeekend, jFeries} = compterPeriode(debut, fin, alsaceMoselle, profil, etatPersonnalise);
  document.getElementById("r-feries").innerHTML = jFeries + "<small> j.</small>";

  /* Durée hebdomadaire : champ vide (aucun message) distingué d'une valeur
     saisie mais inexploitable (message). */
  const inpDuree = document.getElementById("duree-hebdo");
  const dureeStr = inpDuree.value.trim();
  const dureeHebdo = parseFloat(dureeStr);
  let etatDuree = "ok";
  if(dureeStr === "" && !inpDuree.validity.badInput) etatDuree = "vide";
  else if(inpDuree.validity.badInput || isNaN(dureeHebdo) || dureeHebdo <= 0){ etatDuree = "erreur"; montrerErreur(MSG_DUREE_NULLE); }
  else if(dureeHebdo > 48){ etatDuree = "erreur"; montrerErreur(MSG_DUREE_MAX); }

  if(!modeCP){
    ["r-semaines","r-cp","r-rtt","r-heures-rtt"].forEach(id => document.getElementById(id).textContent = "—");
    document.getElementById("r-cp-note").textContent = "";
    return;
  }

  const cpRef = (modeCP === "ouvres") ? 25 : 30;
  const ratio = (joursReference === null) ? 1 : (jCalendaires / joursReference);

  /* Congés payés proratisés, puis convertis en équivalent jours ouvrés
     (lun-ven) pour être homogènes avec le décompte des semaines :
     30 jours ouvrables correspondent à 25 jours ouvrés (5 semaines). */
  const cpApplicable = cpRef * ratio;
  const cpEnJoursOuvres = (modeCP === "ouvrables") ? cpApplicable * 5 / 6 : cpApplicable;

  const joursOuvresBruts = jCalendaires - jWeekend - jFeries;
  const joursOuvresTravailles = Math.max(0, joursOuvresBruts - cpEnJoursOuvres);
  const semainesTravaillees = joursOuvresTravailles / 5;

  document.getElementById("r-semaines").innerHTML = fmt(semainesTravaillees) + "<small> sem.</small>";
  document.getElementById("r-cp").innerHTML = fmt(cpApplicable) + "<small> j.</small>";
  document.getElementById("r-cp-note").textContent = (modeCP === "ouvrables")
    ? "ouvrables, soit " + fmt(cpEnJoursOuvres) + " j. ouvrés déduits"
    : "ouvrés";

  if(etatDuree !== "ok"){
    document.getElementById("r-rtt").textContent = "—";
    document.getElementById("r-heures-rtt").textContent = "—";
    return;
  }

  if(dureeHebdo <= 35){
    if(dureeHebdo < 35) montrerInfo(MSG_SOUS_35);
    document.getElementById("r-rtt").innerHTML = "0<small> j.</small>";
    document.getElementById("r-heures-rtt").innerHTML = "0<small> h.</small>";
    return;
  }

  const delta = dureeHebdo - 35;
  const dureeJournaliere = dureeHebdo / 5;
  const heuresRTT = delta * semainesTravaillees;
  const joursRTT = heuresRTT / dureeJournaliere;

  document.getElementById("r-rtt").innerHTML = fmt(joursRTT) + "<small> j.</small>";
  document.getElementById("r-heures-rtt").innerHTML = fmt(heuresRTT) + "<small> h.</small>";
}

document.getElementById("type-periode").addEventListener("change", () => { basculerBlocs(); calculer(); });
document.getElementById("mode-cp").addEventListener("change", calculer);
document.getElementById("duree-hebdo").addEventListener("input", calculer);
document.getElementById("alsace-moselle").addEventListener("change", calculer);
document.getElementById("profil-feries").addEventListener("change", calculer);
document.getElementById("annee-ref").addEventListener("input", calculer);
document.getElementById("date-debut").addEventListener("change", calculer);
document.getElementById("date-fin").addEventListener("change", calculer);
document.getElementById("date-debut").addEventListener("input", calculer);
document.getElementById("date-fin").addEventListener("input", calculer);

/* Délégation sur la liste dynamique : ses cases n'existent pas encore au
   chargement de la page, donc on écoute sur le conteneur parent. */
document.getElementById("liste-personnalisee").addEventListener("change", (evt) => {
  if(evt.target && evt.target.dataset && evt.target.dataset.cle){
    etatPersonnalise[evt.target.dataset.cle] = evt.target.checked;
    calculer();
  }
});

document.getElementById("vider").addEventListener("click", () => {
  document.getElementById("duree-hebdo").value = "";
  document.getElementById("mode-cp").value = "";
  document.getElementById("alsace-moselle").checked = false;
  document.getElementById("profil-feries").value = "tous";
  document.getElementById("type-periode").value = "";
  document.getElementById("annee-ref").value = "2026";
  document.getElementById("date-debut").value = "";
  document.getElementById("date-fin").value = "";
  for(const cle in etatPersonnalise) delete etatPersonnalise[cle];
  basculerBlocs();
  calculer();
});

basculerBlocs();
</script>
</body>
</html>
