<script is:inline>
/* Calcule la date de Pâques (dimanche) pour une année donnée.
   Algorithme de Gauss / méthode anonyme grégorienne — valable pour toute
   année du calendrier grégorien, aucune table à maintenir. */
function datePaques(annee){
  const a = annee % 19;
  const b = Math.floor(annee / 100);
  const c = annee % 100;
  const d = Math.floor(b / 4);
  const e = b % 4;
  const f = Math.floor((b + 8) / 25);
  const g = Math.floor((b - f + 1) / 3);
  const h = (19*a + b - d - g + 15) % 30;
  const i = Math.floor(c / 4);
  const k = c % 4;
  const l = (32 + 2*e + 2*i - h - k) % 7;
  const m = Math.floor((a + 11*h + 22*l) / 451);
  const val = h + l - 7*m + 114;
  const mois = Math.floor(val / 31); // 3 = mars, 4 = avril
  const jour = (val % 31) + 1;
  return new Date(annee, mois - 1, jour);
}

function ajouterJours(date, n){
  const d = new Date(date);
  d.setDate(d.getDate() + n);
  return d;
}

function iso(d){
  return d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0");
}

/* Jours fériés légaux nationaux (Code du travail, art. L3133-1), dans l'ordre
   du calendrier. Chaque définition a une clé stable (utilisée pour mémoriser
   le choix de personnalisation) et une fonction de calcul dépendant de
   l'année et de la date de Pâques de cette année-là. */
const FERIES_NATIONAUX = [
  {cle:"jour_an",        libelle:"Jour de l'an (1er janvier)",        calc:(a,p)=> new Date(a,0,1)},
  {cle:"lundi_paques",   libelle:"Lundi de Pâques",                   calc:(a,p)=> ajouterJours(p,1)},
  {cle:"fete_travail",   libelle:"Fête du travail (1er mai)",         calc:(a,p)=> new Date(a,4,1)},
  {cle:"victoire_1945",  libelle:"Victoire 1945 (8 mai)",             calc:(a,p)=> new Date(a,4,8)},
  {cle:"ascension",      libelle:"Ascension",                        calc:(a,p)=> ajouterJours(p,39)},
  {cle:"pentecote",      libelle:"Lundi de Pentecôte",                calc:(a,p)=> ajouterJours(p,50)},
  {cle:"fete_nationale", libelle:"Fête nationale (14 juillet)",       calc:(a,p)=> new Date(a,6,14)},
  {cle:"assomption",     libelle:"Assomption (15 août)",              calc:(a,p)=> new Date(a,7,15)},
  {cle:"toussaint",      libelle:"Toussaint (1er novembre)",          calc:(a,p)=> new Date(a,10,1)},
  {cle:"armistice",      libelle:"Armistice 1918 (11 novembre)",      calc:(a,p)=> new Date(a,10,11)},
  {cle:"noel",           libelle:"Noël (25 décembre)",                calc:(a,p)=> new Date(a,11,25)}
];

/* Jours fériés supplémentaires du régime local Alsace-Moselle, ajoutés
   uniquement si l'option correspondante est cochée. */
const FERIES_ALSACE_MOSELLE = [
  {cle:"vendredi_saint", libelle:"Vendredi Saint (Alsace-Moselle)",        calc:(a,p)=> ajouterJours(p,-2)},
  {cle:"saint_etienne",  libelle:"Saint-Étienne, 26 décembre (Alsace-Moselle)", calc:(a,p)=> new Date(a,11,26)}
];

/* Construit une carte "date ISO -> clé de jour férié" pour toutes les années
   couvrant la période, en tenant compte ou non du régime Alsace-Moselle. */
function carteFeries(anneeDebut, anneeFin, alsaceMoselle){
  const defs = alsaceMoselle ? FERIES_NATIONAUX.concat(FERIES_ALSACE_MOSELLE) : FERIES_NATIONAUX;
  const carte = new Map();
  for(let y = anneeDebut; y <= anneeFin; y++){
    const paques = datePaques(y);
    defs.forEach(def => carte.set(iso(def.calc(y, paques)), def.cle));
  }
  return carte;
}

/* Retourne, dans l'ordre du calendrier légal, les définitions de jours
   fériés dont au moins une occurrence tombe dans la période [debut, fin]. */
function feriesPresents(debut, fin, alsaceMoselle){
  const defs = alsaceMoselle ? FERIES_NATIONAUX.concat(FERIES_ALSACE_MOSELLE) : FERIES_NATIONAUX;
  const presents = [];
  for(let y = debut.getFullYear(); y <= fin.getFullYear(); y++){
    const paques = datePaques(y);
    defs.forEach(def => {
      const d = def.calc(y, paques);
      if(d >= debut && d <= fin && !presents.some(p => p.cle === def.cle)){
        presents.push(def);
      }
    });
  }
  return presents;
}

function parseDate(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  return new Date(a, m-1, j);
}

const MSG_ORDRE = "La date de fin doit être postérieure ou égale à la date de début.";
const MSG_INVALIDE = "Date invalide : vérifiez que le jour saisi existe bien dans le mois choisi.";

/* Mémorise, par clé de jour férié, si l'utilisateur l'a décoché en mode
   personnalisé. Absent de cet objet = coché (comportement par défaut). */
const etatPersonnalise = {};

function rendreListePersonnalisee(debut, fin, alsaceMoselle){
  const conteneur = document.getElementById("liste-personnalisee");
  if(!debut || !fin || fin < debut){
    conteneur.innerHTML = '<div class="msg-vide">Renseignez deux dates valides pour afficher la liste des jours fériés de la période.</div>';
    return;
  }
  const presents = feriesPresents(debut, fin, alsaceMoselle);
  if(presents.length === 0){
    conteneur.innerHTML = '<div class="msg-vide">Aucun jour férié sur cette période.</div>';
    return;
  }
  conteneur.innerHTML = presents.map(def => {
    const coche = etatPersonnalise[def.cle] === false ? "" : "checked";
    return '<div class="item-ferie"><input type="checkbox" id="fer-' + def.cle + '" data-cle="' + def.cle + '" ' + coche + '><label for="fer-' + def.cle + '">' + def.libelle + '</label></div>';
  }).join("");
}

function afficherVide(){
  document.getElementById("r-ouvres").textContent = "—";
  document.getElementById("r-ouvrables").textContent = "—";
  document.getElementById("r-calendaires").textContent = "—";
  document.getElementById("r-feries").textContent = "—";
}

function calculer(){
  const inpDebut = document.getElementById("date-debut");
  const inpFin = document.getElementById("date-fin");
  const erreur = document.getElementById("erreur-dates");
  const alsaceMoselle = document.getElementById("alsace-moselle").checked;
  const profil = document.getElementById("profil-feries").value;

  if(inpDebut.validity.badInput || inpFin.validity.badInput){
    erreur.textContent = MSG_INVALIDE;
    erreur.classList.add("visible");
    afficherVide();
    return;
  }

  const debut = parseDate(inpDebut.value);
  const fin = parseDate(inpFin.value);

  document.getElementById("liste-personnalisee").style.display = (profil === "personnalise") ? "block" : "none";
  if(profil === "personnalise"){
    rendreListePersonnalisee(debut, fin, alsaceMoselle);
  }

  if(!debut || !fin){
    afficherVide();
    erreur.classList.remove("visible");
    return;
  }
  if(fin < debut){
    erreur.textContent = MSG_ORDRE;
    erreur.classList.add("visible");
    afficherVide();
    return;
  }
  erreur.classList.remove("visible");

  const carte = carteFeries(debut.getFullYear(), fin.getFullYear(), alsaceMoselle);

  let jCalendaires = 0, jOuvrables = 0, jOuvres = 0, jFeries = 0;
  let cur = new Date(debut);
  while(cur <= fin){
    jCalendaires++;
    const dow = cur.getDay(); // 0 = dimanche, 6 = samedi
    const cle = carte.get(iso(cur));
    const estFerie = !!cle;
    if(estFerie) jFeries++;

    let exclu = false;
    if(estFerie){
      if(profil === "tous") exclu = true;
      else if(profil === "aucun") exclu = false;
      else exclu = etatPersonnalise[cle] !== false; // coché par défaut
    }

    if(dow !== 0 && !exclu) jOuvrables++;
    if(dow !== 0 && dow !== 6 && !exclu) jOuvres++;
    cur = ajouterJours(cur, 1);
  }

  document.getElementById("r-ouvres").innerHTML = jOuvres + "<small> j.</small>";
  document.getElementById("r-ouvrables").innerHTML = jOuvrables + "<small> j.</small>";
  document.getElementById("r-calendaires").innerHTML = jCalendaires + "<small> j.</small>";
  document.getElementById("r-feries").innerHTML = jFeries + "<small> j.</small>";
}

function ajdISO(){
  const d = new Date();
  return d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0");
}

document.getElementById("date-debut").addEventListener("change", calculer);
document.getElementById("date-fin").addEventListener("change", calculer);
document.getElementById("date-debut").addEventListener("input", calculer);
document.getElementById("date-fin").addEventListener("input", calculer);
document.getElementById("alsace-moselle").addEventListener("change", calculer);
document.getElementById("profil-feries").addEventListener("change", calculer);

/* Délégation sur la liste dynamique : ses cases n'existent pas encore au
   chargement de la page, donc on écoute sur le conteneur parent. */
document.getElementById("liste-personnalisee").addEventListener("change", (evt) => {
  if(evt.target && evt.target.dataset && evt.target.dataset.cle){
    etatPersonnalise[evt.target.dataset.cle] = evt.target.checked;
    calculer();
  }
});

document.getElementById("aujourdhui").addEventListener("click", () => {
  document.getElementById("date-fin").value = ajdISO();
  calculer();
});
document.getElementById("vider").addEventListener("click", () => {
  document.getElementById("date-debut").value = "";
  document.getElementById("date-fin").value = "";
  document.getElementById("alsace-moselle").checked = false;
  document.getElementById("profil-feries").value = "tous";
  for(const cle in etatPersonnalise) delete etatPersonnalise[cle];
  calculer();
});

document.getElementById("date-debut").value = ajdISO();
</script>
</body>
</html>
