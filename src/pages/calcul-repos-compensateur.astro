</div>

<script is:inline>
function decFr(d){return d.toFixed(2).replace(".", ",");}

const MSG_NEGATIF = "Les heures ne peuvent pas être négatives.";

function afficherVide(){
  ["r-cor","r-excedent","r-limite","r-taux"].forEach(id=>{
    document.getElementById(id).textContent = "—";
  });
}

function calculer(){
  const erreur = document.getElementById("erreur-msg");
  erreur.classList.remove("visible");

  const heuresSupStr = document.getElementById("heures-sup").value;
  const contingentStr = document.getElementById("contingent").value;
  const effectif = document.getElementById("effectif").value;

  const heuresSup = parseFloat(heuresSupStr);
  const contingent = parseFloat(contingentStr);

  const heuresSupRenseigne = heuresSupStr !== "";
  const contingentRenseigne = contingentStr !== "";

  if(heuresSupRenseigne && (isNaN(heuresSup) || heuresSup < 0)){
    erreur.textContent = MSG_NEGATIF;
    erreur.classList.add("visible");
    afficherVide();
    return;
  }
  if(contingentRenseigne && (isNaN(contingent) || contingent < 0)){
    erreur.textContent = MSG_NEGATIF;
    erreur.classList.add("visible");
    afficherVide();
    return;
  }

  if(!heuresSupRenseigne || !contingentRenseigne){
    afficherVide();
    return;
  }

  const excedent = Math.max(0, heuresSup - contingent);
  const dansLaLimite = Math.min(heuresSup, contingent);

  document.getElementById("r-excedent").innerHTML = decFr(excedent) + "<small> h</small>";
  document.getElementById("r-limite").innerHTML = decFr(dansLaLimite) + "<small> h</small>";

  if(!effectif){
    document.getElementById("r-taux").textContent = "—";
    document.getElementById("r-cor").textContent = "—";
    return;
  }

  const taux = (effectif === "petit") ? 0.5 : 1;
  const tauxLabel = (effectif === "petit") ? "50 % — 30 min / heure" : "100 % — 1 h / heure";
  const cor = excedent * taux;

  document.getElementById("r-taux").textContent = tauxLabel;
  document.getElementById("r-cor").innerHTML = decFr(cor) + "<small> h</small>";
}

document.getElementById("heures-sup").addEventListener("input", calculer);
document.getElementById("contingent").addEventListener("input", calculer);
document.getElementById("effectif").addEventListener("change", calculer);

document.getElementById("vider").addEventListener("click", () => {
  document.getElementById("heures-sup").value = "";
  document.getElementById("contingent").value = "220";
  document.getElementById("effectif").value = "";
  calculer();
});

calculer();
</script>
</body>
</html>
