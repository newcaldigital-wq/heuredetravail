    <li>Temps de travail effectif — <a href="https://code.travail.gouv.fr/code-du-travail/l3121-1" target="_blank" rel="noopener">Code du travail, art. L3121-1</a></li>
    <li>Pause dès 6h de travail dans la journée — <a href="https://code.travail.gouv.fr/code-du-travail/l3121-16" target="_blank" rel="noopener">Code du travail, art. L3121-16</a></li>
    <li>Durées maximales de travail — <a href="https://code.travail.gouv.fr/code-du-travail/l3121-18" target="_blank" rel="noopener">art. L3121-18</a>, <a href="https://code.travail.gouv.fr/code-du-travail/l3121-19" target="_blank" rel="noopener">L3121-19</a>, <a href="https://code.travail.gouv.fr/code-du-travail/l3121-20" target="_blank" rel="noopener">L3121-20</a>, <a href="https://code.travail.gouv.fr/code-du-travail/l3121-21" target="_blank" rel="noopener">L3121-21</a>, <a href="https://code.travail.gouv.fr/code-du-travail/l3121-22" target="_blank" rel="noopener">L3121-22</a>, <a href="https://code.travail.gouv.fr/code-du-travail/l3121-23" target="_blank" rel="noopener">L3121-23</a></li>
    <li>Congés payés et seuil des heures supplémentaires — <a href="https://www.courdecassation.fr/decision/68c13312021d8d629a161216" target="_blank" rel="noopener">Cass. soc., 10 septembre 2025, n° 23-14.455, publié</a></li>
    <li>Fiche pédagogique — <a href="https://code.travail.gouv.fr/fiche-ministere-travail/la-duree-legale-du-travail" target="_blank" rel="noopener">Ministère du Travail, la durée légale du travail</a></li>
  </ul>
</section>
  <footer>
    Salarié à temps complet mensualisé (durée légale française&nbsp;: 35 h/semaine, 151,67 h/mois). Les heures supplémentaires se décomptent à la semaine, au-delà de 35 h, majorées à défaut d'accord à 25 % de la 36<sup>e</sup> à la 43<sup>e</sup> heure puis à 50 % au-delà. Une convention collective peut prévoir d'autres règles. Outil indicatif, ne remplace pas un bulletin de paie.
    <p style="margin-top:12px;font-size:12.5px"><b>Autres calculateurs</b> — <a href="/calcul-temps-de-travail" style="color:var(--vert);font-weight:600">Temps complet, heure réelle</a> · <a href="/heures-complementaires-temps-partiel" style="color:var(--vert);font-weight:600">Temps partiel</a> · <a href="/calcul-anciennete" style="color:var(--vert);font-weight:600">Calcul d'ancienneté</a> · <a href="/calcul-periode-essai" style="color:var(--vert);font-weight:600">Période d'essai</a> · <a href="/calcul-preavis" style="color:var(--vert);font-weight:600">Préavis</a> · <a href="/calcul-heure-de-nuit" style="color:var(--vert);font-weight:600">Heures de nuit</a> · <a href="/conversion-heure-decimale" style="color:var(--vert);font-weight:600">Conversion décimale</a> · <a href="/calcul-jours-ouvres" style="color:var(--vert);font-weight:600">Jours ouvrés/ouvrables</a> · <a href="/calcul-duree-cdd" style="color:var(--vert);font-weight:600">Durée du CDD</a> · <a href="/calcul-carence-cdd" style="color:var(--vert);font-weight:600">Délai de carence CDD</a> · <a href="/calcul-forfait-jours" style="color:var(--vert);font-weight:600">Forfait jours</a> · <a href="/calcul-rtt" style="color:var(--vert);font-weight:600">RTT classique</a> · <a href="/calcul-annualisation-temps-de-travail" style="color:var(--vert);font-weight:600">Annualisation</a> · <a href="/calcul-repos-compensateur" style="color:var(--vert);font-weight:600">Repos compensateur (COR)</a></p>
    <p style="margin-top:12px"><a href="/mentions-legales" style="color:var(--vert);font-weight:600">Mentions légales</a> · <a href="/confidentialite" style="color:var(--vert);font-weight:600">Politique de confidentialité</a> · <a href="/a-propos" style="color:var(--vert);font-weight:600">À propos</a></p>
  </footer>
</div>

<script is:inline>
/* Décompte hebdomadaire des heures supplémentaires (lundi 0 h - dimanche 24 h).
   - Base mensualisée fixe 151,67 h ; tranches 36e-43e (25 %) puis au-delà (50 %), taux légaux supplétifs.
   - Semaine rattachée au mois où elle se termine (dimanche) : convention de l'outil, pas une règle légale.
   - Congés payés : Cass. soc. 10 sept. 2025, n° 23-14.455 (publié). Un jour de CP coché compte dans le
     cumul de la semaine pour le seuil, pour la durée saisie (durée prévue au planning, 7 h par défaut ;
     aucun forfait légal).
   - Choix de prudence (contre-vérifié Perplexity, oct. 2026) : une semaine sans aucune heure travaillée
     (entièrement en CP) ne produit pas d'heures sup. Cas non tranché : l'arrêt vise un salarié
     « partiellement » en congé, et l'indemnité de CP au maintien inclut en principe les heures sup
     habituelles (risque de double prise en compte). Dès 1 minute travaillée, la règle normale s'applique.
   - Mémo interne, non cité dans le texte public : Cass. soc. 7 janv. 2026, n° 24-19.410 (décompte sur
     deux semaines, même solution) ; Cass. soc. 3 juin 2026, n° 24-19.545 (maladie en annualisation :
     seuil réduit) - hors champ de cette page. Jours fériés chômés et maladie : exclus du seuil sauf
     accord ou usage. 5e semaine et congés conventionnels : non tranché.
   - Saisie : un départ à 00:00 vaut minuit (24:00). Une demi-journée incomplète ou dont le départ
     précède l'arrivée n'est pas comptée et est signalée. */
const SEUIL=35, PALIER=8, BASE=151.67;

function tvd(v){if(v==null||v==="")return NaN;const s=String(v).trim().replace(",",".");const m=s.match(/^(\d{1,2})\s*[:hH]\s*(\d{1,2})$/);if(m)return +m[1]+(+m[2])/60;const d=parseFloat(s);return isNaN(d)?NaN:d;}
function demiJournee(a,b){
  const x=tvd(a),y=tvd(b),va=!isNaN(x),vb=!isNaN(y);
  if(!va&&!vb)return {h:0,err:null};
  if(va!==vb)return {h:0,err:"incomplet"};
  const fin=(y===0&&x>0)?24:y;
  if(fin<x)return {h:0,err:"ordre"};
  return {h:fin-x,err:null};
}
function etatJour(rec){const m=demiJournee(rec.am1,rec.am2),p=demiJournee(rec.pm1,rec.pm2);return {h:m.h+p.h,err:m.err||p.err};}
function hJour(a1,a2,p1,p2){return etatJour({am1:a1,am2:a2,pm1:p1,pm2:p2}).h;}
function decHM(d){if(isNaN(d))return"";let h=Math.floor(d+1e-9),m=Math.round((d-h)*60);if(m===60){h++;m=0;}return h+"h"+String(m).padStart(2,"0");}
function decPt(d){return d.toFixed(2);}
function isoSem(dt){const d=new Date(Date.UTC(dt.getFullYear(),dt.getMonth(),dt.getDate()));const j=d.getUTCDay()||7;d.setUTCDate(d.getUTCDate()+4-j);const y=new Date(Date.UTC(d.getUTCFullYear(),0,1));return Math.ceil(((d-y)/86400000+1)/7);}
function cleJour(dt){return dt.getFullYear()+"-"+String(dt.getMonth()+1).padStart(2,"0")+"-"+String(dt.getDate()).padStart(2,"0");}
function lundiDe(dt){const d=new Date(dt);const j=(d.getDay()+6)%7;d.setDate(d.getDate()-j);d.setHours(0,0,0,0);return d;}
function dimancheDe(dt){const l=lundiDe(dt);const d=new Date(l);d.setDate(l.getDate()+6);return d;}

const DATA={};
let DUREE_CP=7;

/* Heures d'un jour : travaillées, ou valeur de la journée de congé payé si la case CP est cochée */
function heuresJour(rec){
  if(rec.cp)return {trav:0,cp:isNaN(DUREE_CP)?0:DUREE_CP,err:null};
  const e=etatJour(rec);return {trav:e.h,cp:0,err:e.err};
}

/* Heures sup d'une semaine (lundi->dimanche), rattachées au mois du dimanche */
function supSemaine(lundi){
  let trav=0,cp=0,nbcp=0;
  for(let i=0;i<7;i++){
    const d=new Date(lundi);d.setDate(lundi.getDate()+i);
    const j=heuresJour(DATA[cleJour(d)]||{});trav+=j.trav;cp+=j.cp;if((DATA[cleJour(d)]||{}).cp)nbcp++;
  }
  const cpCompte=trav>0?cp:0;
  const tot=trav+cpCompte;
  const s25=Math.min(PALIER,Math.max(0,tot-SEUIL)),s50=Math.max(0,tot-SEUIL-PALIER);
  const dim=new Date(lundi);dim.setDate(lundi.getDate()+6);
  return {s25,s50,trav,cp:cpCompte,nbcp:trav>0?nbcp:0,moisFin:dim.getFullYear()+"-"+String(dim.getMonth()+1).padStart(2,"0")};
}

/* Total du mois : base fixe + sup des semaines qui se terminent dans le mois */
function calcMois(annee,mois){
  const premier=new Date(annee,mois,1),dernier=new Date(annee,mois+1,0);
  let l=lundiDe(premier);const fin=lundiDe(dernier);
  let s25=0,s50=0,cp=0,nbcp=0;const cle=annee+"-"+String(mois+1).padStart(2,"0");
  while(l<=fin){const s=supSemaine(l);if(s.moisFin===cle){s25+=s.s25;s50+=s.s50;cp+=s.cp;nbcp+=s.nbcp;}const nx=new Date(l);nx.setDate(l.getDate()+7);l=nx;}
  return {base:BASE,s25,s50,cp,nbcp,total:BASE+s25+s50};
}

const MOIS=["Janvier","Février","Mars","Avril","Mai","Juin","Juillet","Août","Septembre","Octobre","Novembre","Décembre"];
const JOURS=["lun","mar","mer","jeu","ven","sam","dim"];
const selMois=document.getElementById("mois"),inAnnee=document.getElementById("annee"),inCP=document.getElementById("dureecp");
MOIS.forEach((m,i)=>{const o=document.createElement("option");o.value=i;o.textContent=m;selMois.appendChild(o);});
const now=new Date();selMois.value=now.getMonth();inAnnee.value=now.getFullYear();

function anneeValide(){const v=String(inAnnee.value).trim();const n=Number(v);return (v!==""&&Number.isInteger(n)&&n>=2000&&n<=2100)?n:null;}
function lireDureeCP(){DUREE_CP=tvd(inCP.value);}
function jjmm(k){return k.slice(8,10)+"/"+k.slice(5,7);}
function celluleHeures(k){
  const rec=DATA[k]||{};
  if(rec.cp)return {txt:"CP · "+(isNaN(DUREE_CP)?"0h00":decHM(DUREE_CP)),err:null};
  const e=etatJour(rec);
  if(e.err)return {txt:"⚠ "+(e.h>0?decHM(e.h):""),err:e.err};
  return {txt:e.h>0?decHM(e.h):"—",err:null};
}
function majLigne(tr){
  const k=tr.dataset.date,rec=DATA[k]||{},c=celluleHeures(k);
  tr.querySelector("[data-h]").textContent=c.txt;
  tr.classList.toggle("cp",!!rec.cp);
  tr.classList.toggle("err",!!c.err);
  tr.querySelectorAll("input[type=time]").forEach(i=>{i.disabled=!!rec.cp;});
}
function sauveLigne(tr){
  const k=tr.dataset.date;
  DATA[k]={am1:tr.querySelector(".am1").value,am2:tr.querySelector(".am2").value,pm1:tr.querySelector(".pm1").value,pm2:tr.querySelector(".pm2").value,cp:tr.querySelector(".cp").checked};
  majLigne(tr);
  calculer();
}
function ligneHTML(date,report){
  const jw=(date.getDay()+6)%7,sem=isoSem(date),k=cleJour(date),rec=DATA[k]||{},c=celluleHeures(k),dis=rec.cp?" disabled":"";
  const cls=[report?"report":"",jw>=5?"we":"",rec.cp?"cp":"",c.err?"err":""].filter(Boolean).join(" ");
  const dd=String(date.getDate()).padStart(2,"0")+"/"+String(date.getMonth()+1).padStart(2,"0");
  return '<tr class="'+cls+'" data-date="'+k+'">'
    +'<td class="semlabel">'+(jw===0?sem:"")+'</td>'
    +'<td class="date">'+dd+'</td>'
    +'<td class="jour">'+JOURS[jw]+'</td>'
    +'<td><input type="checkbox" class="cp" aria-label="Congé payé le '+dd+'"'+(rec.cp?" checked":"")+'></td>'
    +'<td><input type="time" class="am1" aria-label="Arrivée matin le '+dd+'" value="'+(rec.am1||"")+'"'+dis+'></td>'
    +'<td><input type="time" class="am2" aria-label="Départ matin le '+dd+'" value="'+(rec.am2||"")+'"'+dis+'></td>'
    +'<td><input type="time" class="pm1" aria-label="Arrivée après-midi le '+dd+'" value="'+(rec.pm1||"")+'"'+dis+'></td>'
    +'<td><input type="time" class="pm2" aria-label="Départ après-midi le '+dd+'" value="'+(rec.pm2||"")+'"'+dis+'></td>'
    +'<td class="htot" data-h>'+c.txt+'</td></tr>';
}
function construire(){
  const annee=anneeValide();
  document.getElementById("err-annee").hidden=annee!==null;
  if(annee===null){document.getElementById("corps").innerHTML="";return;}
  const mois=+selMois.value;
  const premier=new Date(annee,mois,1),dernier=new Date(annee,mois+1,0);
  let html="";
  const lun1=lundiDe(premier);
  for(let d=new Date(lun1);d<premier;d.setDate(d.getDate()+1))html+=ligneHTML(new Date(d),true);
  for(let d=1;d<=dernier.getDate();d++)html+=ligneHTML(new Date(annee,mois,d),false);
  const dim=dimancheDe(dernier);
  for(let d=new Date(dernier.getTime()+86400000);d<=dim;d.setDate(d.getDate()+1))html+=ligneHTML(new Date(d),true);
  const corps=document.getElementById("corps");corps.innerHTML=html;
  corps.querySelectorAll("input").forEach(inp=>{
    inp.addEventListener("input",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("change",()=>sauveLigne(inp.closest("tr")));
    if(inp.type==="time")inp.addEventListener("blur",()=>sauveLigne(inp.closest("tr")));
  });
}
function majAlertes(){
  const box=document.getElementById("alertes"),msgs=[];
  let cpCoche=false;
  document.querySelectorAll("#corps tr").forEach(tr=>{
    const k=tr.dataset.date,rec=DATA[k]||{};
    if(rec.cp){cpCoche=true;return;}
    const e=etatJour(rec);
    if(e.err==="incomplet")msgs.push(jjmm(k)+" : horaire incomplet (arrivée ou départ manquant). Cette demi-journée n'est pas comptée.");
    if(e.err==="ordre")msgs.push(jjmm(k)+" : le départ est avant l'arrivée. Cette demi-journée n'est pas comptée. Si l'horaire passe minuit, arrêtez-le à 00:00 et saisissez la suite sur le jour suivant.");
  });
  if(cpCoche&&isNaN(DUREE_CP))msgs.push("La durée de la journée de congé payé est vide : les jours CP comptent pour 0 h.");
  box.hidden=msgs.length===0;
  box.innerHTML=msgs.length?"<b>À vérifier</b><ul>"+msgs.map(m=>"<li>"+m+"</li>").join("")+"</ul>":"";
}
function afficheVide(){
  ["r-s25","r-s50"].forEach(id=>{document.getElementById(id).innerHTML='—<small> h</small>';});
  document.getElementById("r-cp").hidden=true;
}
function calculer(){
  majAlertes();
  const annee=anneeValide();
  if(annee===null){afficheVide();return;}
  const r=calcMois(annee,+selMois.value);
  document.getElementById("r-base").innerHTML=decPt(r.base)+'<small> h</small>';
  document.getElementById("r-s25").innerHTML=decPt(r.s25)+'<small> h · '+decHM(r.s25)+'</small>';
  document.getElementById("r-s50").innerHTML=decPt(r.s50)+'<small> h · '+decHM(r.s50)+'</small>';
  const pcp=document.getElementById("r-cp");
  if(r.nbcp>0){pcp.hidden=false;pcp.textContent="Congés payés intégrés au seuil des 35 h : "+decPt(r.cp)+" h ("+r.nbcp+" jour"+(r.nbcp>1?"s":"")+").";}
  else pcp.hidden=true;
}
function exemple(){
  const annee=anneeValide();if(annee===null)return;
  const mois=+selMois.value,nb=new Date(annee,mois+1,0).getDate();
  for(let d=1;d<=nb;d++){const dt=new Date(annee,mois,d),jw=(dt.getDay()+6)%7;if(jw<5)DATA[cleJour(dt)]={am1:"08:30",am2:"12:30",pm1:"13:30",pm2:"17:30"};}
  construire();calculer();
}
function vider(){
  const annee=anneeValide();if(annee===null)return;
  const mois=+selMois.value,nb=new Date(annee,mois+1,0).getDate();
  for(let d=1;d<=nb;d++)delete DATA[cleJour(new Date(annee,mois,d))];
  construire();calculer();
}
function changeMois(delta){
  let m=+selMois.value+delta,y=anneeValide();if(y===null)y=now.getFullYear();
  if(m<0){m=11;y--;}else if(m>11){m=0;y++;}
  selMois.value=m;inAnnee.value=y;construire();calculer();
}
selMois.addEventListener("change",()=>{construire();calculer();});
inAnnee.addEventListener("change",()=>{construire();calculer();});
inCP.addEventListener("change",()=>{lireDureeCP();construire();calculer();});
inCP.addEventListener("input",()=>{lireDureeCP();construire();calculer();});
document.getElementById("prev").addEventListener("click",()=>changeMois(-1));
document.getElementById("next").addEventListener("click",()=>changeMois(1));
document.getElementById("calculer").addEventListener("click",calculer);
document.getElementById("exemple").addEventListener("click",exemple);
document.getElementById("vider").addEventListener("click",vider);
lireDureeCP();
construire();calculer();
</script>
</body>
</html>
