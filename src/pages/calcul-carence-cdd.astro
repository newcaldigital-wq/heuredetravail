<script is:inline>
/* ---------- Fonctions de date ---------- */
function parseDateInput(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  return new Date(a, m-1, j);
}
function ajouterJours(date, n){
  const d = new Date(date);
  d.setDate(d.getDate() + n);
  return d;
}
function joursEntre(d1, d2){
  return Math.round((d2 - d1) / 86400000);
}
function formatDateFr(d){
  const jours = ["dimanche","lundi","mardi","mercredi","jeudi","vendredi","samedi"];
  const mois = ["janvier","février","mars","avril","mai","juin","juillet","août","septembre","octobre","novembre","décembre"];
  return jours[d.getDay()] + " " + d.getDate() + " " + mois[d.getMonth()] + " " + d.getFullYear();
}

/* ---------- État ---------- */
let memePoste = "oui";
let fermetureCompteur = 0;

/* ---------- Bloc "même poste" ---------- */
document.querySelectorAll("#meme-poste-type .seg-btn").forEach(b => b.addEventListener("click", () => {
  memePoste = b.dataset.val;
  document.querySelectorAll("#meme-poste-type .seg-btn").forEach(x => x.classList.toggle("active", x === b));
  calculerTout();
}));

/* ---------- Bloc 2 : durée du CDD précédent ---------- */
function calculerDelaiRequis(){
  const debut = parseDateInput(document.getElementById("precedent-debut").value);
  const fin = parseDateInput(document.getElementById("precedent-fin").value);
  if(!debut || !fin || fin < debut) return null;
  const dureeJours = joursEntre(debut, fin) + 1;
  const fraction = dureeJours >= 14 ? (1/3) : (1/2);
  const delaiRequis = Math.ceil(dureeJours * fraction);
  return { debut, fin, dureeJours, fraction, delaiRequis };
}

function afficherBloc2(info){
  const dureeEl = document.getElementById("r-duree-precedent");
  const fractionEl = document.getElementById("r-fraction");
  const delaiEl = document.getElementById("r-delai-requis");
  if(!info){
    dureeEl.textContent = "—";
    fractionEl.textContent = "—";
    delaiEl.textContent = "—";
    return;
  }
  dureeEl.innerHTML = info.dureeJours + "<small> jour(s)</small>";
  fractionEl.textContent = info.fraction === (1/3) ? "1/3 (≥ 14 jours)" : "1/2 (< 14 jours)";
  delaiEl.innerHTML = info.delaiRequis + "<small> jour(s) d'ouverture</small>";
}

/* ---------- Bloc 3 : exceptions ---------- */
function exceptionActive(){
  return [...document.querySelectorAll(".exception-check")].some(cb => cb.checked);
}
document.querySelectorAll(".exception-check").forEach(cb => cb.addEventListener("change", calculerTout));

/* ---------- Bloc 4 : rythme + fermetures ---------- */
document.querySelectorAll(".jour-ouverture").forEach(cb => cb.addEventListener("change", calculerTout));

function getRythme(){
  return [1,2,3,4,5,6,7].map(i => document.getElementById("jour-" + i).checked);
}
function getFermetures(){
  const out = [];
  document.querySelectorAll(".fermeture-row").forEach(row => {
    const d = parseDateInput(row.querySelector(".fermeture-debut").value);
    const f = parseDateInput(row.querySelector(".fermeture-fin").value);
    if(d && f && f >= d) out.push({ debut: d, fin: f });
  });
  return out;
}
function estJourOuverture(date, rythme, fermetures){
  const jourSemaine = date.getDay();
  const idx = jourSemaine === 0 ? 6 : jourSemaine - 1;
  if(!rythme[idx]) return false;
  for(const f of fermetures){
    if(date >= f.debut && date <= f.fin) return false;
  }
  return true;
}
function calculerDateCarence(finPrecedent, delaiRequis, rythme, fermetures){
  let cursor = ajouterJours(finPrecedent, 1);
  let compte = 0;
  let dernierJour = null;
  let securite = 0;
  while(compte < delaiRequis && securite < 3650){
    if(estJourOuverture(cursor, rythme, fermetures)){
      compte++;
      dernierJour = cursor;
    }
    if(compte < delaiRequis){
      cursor = ajouterJours(cursor, 1);
    }
    securite++;
  }
  if(!dernierJour) return null;
  // Approche prudente : le nouveau CDD débute au premier jour d'ouverture suivant
  // le dernier jour compté (et non n'importe quel jour calendaire).
  let resultat = ajouterJours(dernierJour, 1);
  let securite2 = 0;
  while(!estJourOuverture(resultat, rythme, fermetures) && securite2 < 3650){
    resultat = ajouterJours(resultat, 1);
    securite2++;
  }
  return resultat;
}

function addFermetureRow(){
  fermetureCompteur++;
  const row = document.createElement("div");
  row.className = "fermeture-row";
  row.innerHTML =
    '<input type="date" class="fermeture-debut" aria-label="Début de la période de fermeture">' +
    '<span>→</span>' +
    '<input type="date" class="fermeture-fin" aria-label="Fin de la période de fermeture">' +
    '<button type="button" class="btn-suppr" aria-label="Supprimer cette période">✕ Retirer</button>';
  document.getElementById("fermetures-liste").appendChild(row);
  row.querySelectorAll("input").forEach(inp => inp.addEventListener("change", calculerTout));
  row.querySelector(".btn-suppr").addEventListener("click", () => { row.remove(); calculerTout(); });
}
document.getElementById("btn-ajouter-fermeture").addEventListener("click", addFermetureRow);

/* ---------- Calcul global ---------- */
function calculerTout(){
  const resultatNonPoste = document.getElementById("resultat-non-poste");
  const resteCalcul = document.getElementById("reste-calcul");

  if(memePoste === "non"){
    resultatNonPoste.classList.add("visible");
    resteCalcul.style.display = "none";
    return;
  }
  resultatNonPoste.classList.remove("visible");
  resteCalcul.style.display = "block";

  const info = calculerDelaiRequis();
  afficherBloc2(info);

  const exception = exceptionActive();
  const resultatException = document.getElementById("resultat-exception");
  const panneauCalcul = document.getElementById("panneau-calcul");
  const dateEl = document.getElementById("r-date-carence");

  if(exception){
    resultatException.classList.add("visible");
    panneauCalcul.style.display = "none";
    return;
  }
  resultatException.classList.remove("visible");
  panneauCalcul.style.display = "block";

  if(!info){
    dateEl.textContent = "Renseignez les dates du CDD précédent";
    dateEl.classList.add("vide");
    return;
  }

  const rythme = getRythme();
  const fermetures = getFermetures();
  const resultat = calculerDateCarence(info.fin, info.delaiRequis, rythme, fermetures);

  if(!resultat){
    dateEl.textContent = "Aucun jour d'ouverture trouvé — vérifiez le rythme hebdomadaire";
    dateEl.classList.add("vide");
    return;
  }
  dateEl.textContent = formatDateFr(resultat);
  dateEl.classList.remove("vide");
}

document.getElementById("precedent-debut").addEventListener("change", calculerTout);
document.getElementById("precedent-fin").addEventListener("change", calculerTout);

calculerTout();
</script>
</body>
