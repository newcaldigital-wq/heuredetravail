<script is:inline>
/* Compteur d'heures réelles, décompte hebdomadaire (lundi 0 h - dimanche 24 h), sans base forfaitaire.
   - Chaque heure reste sur le jour calendaire où elle est travaillée. Le seuil de 35 h porte sur la
     semaine civile complète, même à cheval sur deux mois. Dans la semaine, les heures sont classées
     dans l'ordre chronologique (35 premières normales, 8 suivantes à 25 %, au-delà 50 %) ; seules
     celles du mois affiché sont additionnées. Convention de l'outil (aucun texte ne fixe la méthode
     de rattachement à un mois de paie ; contre-vérifié Perplexity, oct. 2026).
   - Congés payés : Cass. soc. 10 sept. 2025, n° 23-14.455 (FP-B+R). Les heures de CP (durée saisie,
     7 h par défaut, pas de forfait légal) sont traitées comme du temps de travail effectif, sans
     plafond à 35 h (arrêt, point 18 ; fiche service-public F2391). Elles comptent en premier dans le
     cumul de la semaine (convention de l'outil) et se rangent dans les tranches comme des heures
     travaillées (d'abord en heures normales), puis sont neutralisées en paie par l'absence CP et
     l'indemnité. Semaine entièrement en CP : tout en heures normales, aucune heure sup (choix de
     prudence, cas non tranché). Maladie et fériés chômés : hors du seuil, non saisis.
   - Mémo interne, non cité dans le texte public : Cass. soc. 7 janv. 2026, n° 24-19.410 (décompte sur
     deux semaines) ; Cass. soc. 3 juin 2026, n° 24-19.545 (maladie en annualisation) ; heures sup
     faites avec l'accord au moins implicite de l'employeur ou rendues nécessaires par les tâches
     (Cass. soc. 14 nov. 2018, n° 17-16.959, publié, selon Perplexity, non vérifié ici). Intérim,
     plusieurs missions la même semaine : non tranché, renvoi vers l'agence.
   - Seuil non proratisé en cas d'entrée ou de sortie en cours de semaine.
   - Saisie : un départ à 00:00 vaut minuit (24:00). Une demi-journée incomplète ou dont le départ
     précède l'arrivée n'est pas comptée et est signalée. */
const SEUIL=35, PALIER=8;

function tvd(v){if(v==null||v==="")return NaN;const s=String(v).trim().replace(",",".");const m=s.match(/^(\d{1,2})\s*[:hH]\s*(\d{1,2})$/);if(m)return +m[1]+(+m[2])/60;const d=parseFloat(s);return isNaN(d)?NaN:d;}
function demiJournee(a,b){
  const x=tvd(a),y=tvd(b),va=!isNaN(x),vb=!isNaN(y);
  if(!va&&!vb)return {h:0,err:null};
  if(va!==vb)return {h:0,err:"incomplet"};
  const fin=(y===0&&x>0)?24:y;
  if(fin<x)return {h:0,err:"ordre"};
  return {h:fin-x,err:null};
}
function etatJour(rec){const m=demiJournee(rec.am1,rec.am2),p=demiJournee(rec.pm1,rec.pm2);return {h:m.h+p.h,err:m.err||p.err};}
function hJour(a1,a2,p1,p2){return etatJour({am1:a1,am2:a2,pm1:p1,pm2:p2}).h;}
function decHM(d){if(isNaN(d))return"";let h=Math.floor(d+1e-9),m=Math.round((d-h)*60);if(m===60){h++;m=0;}return h+"h"+String(m).padStart(2,"0");}
function decPt(d){return d.toFixed(2);}
function isoSem(dt){const d=new Date(Date.UTC(dt.getFullYear(),dt.getMonth(),dt.getDate()));const j=d.getUTCDay()||7;d.setUTCDate(d.getUTCDate()+4-j);const y=new Date(Date.UTC(d.getUTCFullYear(),0,1));return Math.ceil(((d-y)/86400000+1)/7);}
function cleJour(dt){return dt.getFullYear()+"-"+String(dt.getMonth()+1).padStart(2,"0")+"-"+String(dt.getDate()).padStart(2,"0");}
function lundiDe(dt){const d=new Date(dt);const j=(d.getDay()+6)%7;d.setDate(d.getDate()-j);d.setHours(0,0,0,0);return d;}
function dimancheDe(dt){const l=lundiDe(dt);const d=new Date(l);d.setDate(l.getDate()+6);return d;}

const DATA={};
let DUREE_CP=7;
function valeurCP(){return isNaN(DUREE_CP)?0:DUREE_CP;}

/* Total du mois : chaque heure travaillée est classée selon le cumul de sa semaine civile
   (CP de la semaine comptés en premier), et seuls les jours du mois affiché sont additionnés. */
function calcMoisReel(annee,mois){
  const premier=new Date(annee,mois,1),dernier=new Date(annee,mois+1,0);
  let l=lundiDe(premier);const finBoucle=lundiDe(dernier);
  let normal=0,s25=0,s50=0,cpH=0,cpJ=0,trav=0;
  const tranches=(av,h)=>{const ap=av+h;return [Math.max(0,Math.min(ap,SEUIL)-av),Math.max(0,Math.min(ap,SEUIL+PALIER)-Math.max(av,SEUIL)),Math.max(0,ap-Math.max(av,SEUIL+PALIER))];};
  while(l<=finBoucle){
    const jours=[];let travSem=0;
    for(let i=0;i<7;i++){const d=new Date(l);d.setDate(l.getDate()+i);const rec=DATA[cleJour(d)]||{};jours.push({d,rec,dansMois:d.getFullYear()===annee&&d.getMonth()===mois});if(!rec.cp)travSem+=etatJour(rec).h;}
    /* 1) Jours de CP, comptés en premier dans le cumul (temps de travail effectif, sans plafond) :
          ils se rangent d'abord en heures normales. Semaine sans heure travaillée : tout en heures
          normales, aucune heure sup (choix de prudence). */
    let cumul=0;
    for(const j of jours){
      if(!j.rec.cp)continue;
      const v=valeurCP(),t=travSem>0?tranches(cumul,v):[v,0,0];cumul+=v;
      if(j.dansMois){cpH+=v;cpJ++;normal+=t[0];s25+=t[1];s50+=t[2];}
    }
    /* 2) Heures travaillées, dans l'ordre des jours, rattachées à leur jour réel. */
    for(const j of jours){
      if(j.rec.cp)continue;
      const h=etatJour(j.rec).h,t=tranches(cumul,h);cumul+=h;
      if(j.dansMois){trav+=h;normal+=t[0];s25+=t[1];s50+=t[2];}
    }
    const nx=new Date(l);nx.setDate(l.getDate()+7);l=nx;
  }
  return {normal,s25,s50,total:normal+s25+s50,cpH,cpJ,trav};
}

const MOIS=["Janvier","Février","Mars","Avril","Mai","Juin","Juillet","Août","Septembre","Octobre","Novembre","Décembre"];
const JOURS=["lun","mar","mer","jeu","ven","sam","dim"];
const selMois=document.getElementById("mois"),inAnnee=document.getElementById("annee"),inCP=document.getElementById("dureecp");
MOIS.forEach((m,i)=>{const o=document.createElement("option");o.value=i;o.textContent=m;selMois.appendChild(o);});
const now=new Date();selMois.value=now.getMonth();inAnnee.value=now.getFullYear();

function anneeValide(){const v=String(inAnnee.value).trim();const n=Number(v);return (v!==""&&Number.isInteger(n)&&n>=2000&&n<=2100)?n:null;}
function lireDureeCP(){DUREE_CP=tvd(inCP.value);}
function jjmm(k){return k.slice(8,10)+"/"+k.slice(5,7);}
function celluleHeures(k){
  const rec=DATA[k]||{};
  if(rec.cp)return {txt:"CP · "+decHM(valeurCP()),err:null};
  const e=etatJour(rec);
  if(e.err)return {txt:"⚠ "+(e.h>0?decHM(e.h):""),err:e.err};
  return {txt:e.h>0?decHM(e.h):"—",err:null};
}
function majLigne(tr){
  const k=tr.dataset.date,rec=DATA[k]||{},c=celluleHeures(k);
  tr.querySelector("[data-h]").textContent=c.txt;
  tr.classList.toggle("cp",!!rec.cp);
  tr.classList.toggle("err",!!c.err);
  tr.querySelectorAll("input[type=time]").forEach(i=>{i.disabled=!!rec.cp;});
}
function sauveLigne(tr){
  const k=tr.dataset.date;
  DATA[k]={am1:tr.querySelector(".am1").value,am2:tr.querySelector(".am2").value,pm1:tr.querySelector(".pm1").value,pm2:tr.querySelector(".pm2").value,cp:tr.querySelector(".cp").checked};
  majLigne(tr);
  calculer();
}
function ligneHTML(date,report){
  const jw=(date.getDay()+6)%7,sem=isoSem(date),k=cleJour(date),rec=DATA[k]||{},c=celluleHeures(k),dis=rec.cp?" disabled":"";
  const cls=[report?"report":"",jw>=5?"we":"",rec.cp?"cp":"",c.err?"err":""].filter(Boolean).join(" ");
  const dd=String(date.getDate()).padStart(2,"0")+"/"+String(date.getMonth()+1).padStart(2,"0");
  return '<tr class="'+cls+'" data-date="'+k+'">'
    +'<td class="semlabel">'+(jw===0?sem:"")+'</td>'
    +'<td class="date">'+dd+'</td>'
    +'<td class="jour">'+JOURS[jw]+'</td>'
    +'<td><input type="checkbox" class="cp" aria-label="Congé payé le '+dd+'"'+(rec.cp?" checked":"")+'></td>'
    +'<td><input type="time" class="am1" aria-label="Arrivée matin le '+dd+'" value="'+(rec.am1||"")+'"'+dis+'></td>'
    +'<td><input type="time" class="am2" aria-label="Départ matin le '+dd+'" value="'+(rec.am2||"")+'"'+dis+'></td>'
    +'<td><input type="time" class="pm1" aria-label="Arrivée après-midi le '+dd+'" value="'+(rec.pm1||"")+'"'+dis+'></td>'
    +'<td><input type="time" class="pm2" aria-label="Départ après-midi le '+dd+'" value="'+(rec.pm2||"")+'"'+dis+'></td>'
    +'<td class="htot" data-h>'+c.txt+'</td></tr>';
}
function construire(){
  const annee=anneeValide();
  document.getElementById("err-annee").hidden=annee!==null;
  if(annee===null){document.getElementById("corps").innerHTML="";return;}
  const mois=+selMois.value;
  const premier=new Date(annee,mois,1),dernier=new Date(annee,mois+1,0);
  let html="";
  const lun1=lundiDe(premier);
  for(let d=new Date(lun1);d<premier;d.setDate(d.getDate()+1))html+=ligneHTML(new Date(d),true);
  for(let d=1;d<=dernier.getDate();d++)html+=ligneHTML(new Date(annee,mois,d),false);
  const dim=dimancheDe(dernier);
  for(let d=new Date(dernier.getTime()+86400000);d<=dim;d.setDate(d.getDate()+1))html+=ligneHTML(new Date(d),true);
  const corps=document.getElementById("corps");corps.innerHTML=html;
  corps.querySelectorAll("input").forEach(inp=>{
    inp.addEventListener("input",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("change",()=>sauveLigne(inp.closest("tr")));
    if(inp.type==="time")inp.addEventListener("blur",()=>sauveLigne(inp.closest("tr")));
  });
}
function majAlertes(){
  const box=document.getElementById("alertes"),msgs=[];
  let cpCoche=false;
  document.querySelectorAll("#corps tr").forEach(tr=>{
    const k=tr.dataset.date,rec=DATA[k]||{};
    if(rec.cp){cpCoche=true;return;}
    const e=etatJour(rec);
    if(e.err==="incomplet")msgs.push(jjmm(k)+" : horaire incomplet (arrivée ou départ manquant). Cette demi-journée n'est pas comptée.");
    if(e.err==="ordre")msgs.push(jjmm(k)+" : le départ est avant l'arrivée. Cette demi-journée n'est pas comptée. Si l'horaire passe minuit, arrêtez-le à 00:00 et saisissez la suite sur le jour suivant.");
  });
  if(cpCoche&&isNaN(DUREE_CP))msgs.push("La durée de la journée de congé payé est vide : les jours CP comptent pour 0 h.");
  box.hidden=msgs.length===0;
  box.innerHTML=msgs.length?"<b>À vérifier</b><ul>"+msgs.map(m=>"<li>"+m+"</li>").join("")+"</ul>":"";
}
function carte(id,v){document.getElementById(id).innerHTML=decPt(v)+'<small> h · '+decHM(v)+'</small>';}
function calculer(){
  majAlertes();
  const annee=anneeValide();
  if(annee===null){["r-nrm","r-s25","r-s50","r-tot"].forEach(id=>{document.getElementById(id).innerHTML='—<small> h</small>';});document.getElementById("r-cp").hidden=true;return;}
  const r=calcMoisReel(annee,+selMois.value);
  carte("r-nrm",r.normal);carte("r-s25",r.s25);carte("r-s50",r.s50);carte("r-tot",r.total);
  const pcp=document.getElementById("r-cp");
  if(r.cpJ>0){pcp.hidden=false;pcp.textContent="Dont congés payés : "+decPt(r.cpH)+" h ("+r.cpJ+" jour"+(r.cpJ>1?"s":"")+") · dont heures travaillées : "+decPt(r.trav)+" h.";}
  else pcp.hidden=true;
}
function exemple(){
  const annee=anneeValide();if(annee===null)return;
  const mois=+selMois.value,nb=new Date(annee,mois+1,0).getDate();
  for(let d=1;d<=nb;d++){const dt=new Date(annee,mois,d),jw=(dt.getDay()+6)%7;if(jw<5)DATA[cleJour(dt)]={am1:"08:00",am2:"12:00",pm1:"13:00",pm2:"18:00"};}
  construire();calculer();
}
function vider(){
  const annee=anneeValide();if(annee===null)return;
  const mois=+selMois.value,nb=new Date(annee,mois+1,0).getDate();
  for(let d=1;d<=nb;d++)delete DATA[cleJour(new Date(annee,mois,d))];
  construire();calculer();
}
function changeMois(delta){
  let m=+selMois.value+delta,y=anneeValide();if(y===null)y=now.getFullYear();
  if(m<0){m=11;y--;}else if(m>11){m=0;y++;}
  selMois.value=m;inAnnee.value=y;construire();calculer();
}
selMois.addEventListener("change",()=>{construire();calculer();});
inAnnee.addEventListener("change",()=>{construire();calculer();});
inCP.addEventListener("change",()=>{lireDureeCP();construire();calculer();});
inCP.addEventListener("input",()=>{lireDureeCP();construire();calculer();});
document.getElementById("prev").addEventListener("click",()=>changeMois(-1));
document.getElementById("next").addEventListener("click",()=>changeMois(1));
document.getElementById("calculer").addEventListener("click",calculer);
document.getElementById("exemple").addEventListener("click",exemple);
document.getElementById("vider").addEventListener("click",vider);
lireDureeCP();
construire();calculer();
</script>
</body>
</html>
