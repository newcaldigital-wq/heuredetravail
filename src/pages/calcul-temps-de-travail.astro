<title>Calcul du temps de travail réel — France</title>
<meta name="description" content="Calculez votre temps de travail réel, sans base forfaitaire : heures normales et heures supplémentaires additionnées jour par jour, semaine par semaine, congés payés inclus.">
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<style is:global>
