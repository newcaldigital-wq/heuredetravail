<script is:inline>
/* ---------- Fonctions de date ---------- */
function ajouterMois(date, n){
  const d = new Date(date.getFullYear(), date.getMonth() + n, date.getDate());
  if(d.getDate() !== date.getDate()){
    return new Date(date.getFullYear(), date.getMonth() + n + 1, 0);
  }
  return d;
}
function veilleDe(date){
  const d = new Date(date);
  d.setDate(d.getDate() - 1);
  return d;
}
function parseDateInput(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  return new Date(a, m-1, j);
}
function joursEntre(d1, d2){
  return Math.round((d2 - d1) / 86400000);
}
function formatDateFr(d){
  const jours = ["dimanche","lundi","mardi","mercredi","jeudi","vendredi","samedi"];
  const mois = ["janvier","février","mars","avril","mai","juin","juillet","août","septembre","octobre","novembre","décembre"];
  return jours[d.getDay()] + " " + d.getDate() + " " + mois[d.getMonth()] + " " + d.getFullYear();
}

/* ---------- Données des motifs ---------- */
const MOTIFS = {
  remplacement:     { maxDefaut: 18, etrangerPossible: true,  maxEtranger: 24 },
  accroissement:    { maxDefaut: 18, etrangerPossible: true,  maxEtranger: 24 },
  attente_cdi:      { maxDefaut: 9,  etrangerPossible: false },
  depart_definitif: { maxDefaut: 24, etrangerPossible: false },
  travaux_urgents:  { maxDefaut: 9,  etrangerPossible: false }
};

/* ---------- État de l'interface ---------- */
let termeType = "precis";

/* ---------- Calcul du plafond applicable ---------- */
function calculerPlafond(){
  const motifKey = document.getElementById("motif").value;
  if(!motifKey) return null;

  const brancheRaw = parseFloat(document.getElementById("branche").value);
  const brancheValide = !isNaN(brancheRaw) && brancheRaw > 0;

  if(motifKey === "saisonnier_usage"){
    if(termeType === "sans"){
      return { sansTerme: true };
    }
    let max = brancheValide ? Math.round(brancheRaw) : 18;
    return { max, brancheAppliquee: brancheValide, sansTerme: false };
  }

  const motif = MOTIFS[motifKey];
  let max = motif.maxDefaut;
  if(motif.etrangerPossible && document.getElementById("etranger").checked){
    max = motif.maxEtranger;
  }
  if(brancheValide){
    max = Math.round(brancheRaw);
  }
  return { max, brancheAppliquee: brancheValide, sansTerme: false };
}

/* ---------- Bloc 1 : affichage du plafond ---------- */
function afficherBloc1(info){
  const noteSansTerme = document.getElementById("note-sans-terme");
  const noteConvention = document.getElementById("note-convention");
  const valEl = document.getElementById("r-duree-max");

  if(!info){
    valEl.textContent = "—";
    noteSansTerme.classList.remove("visible");
    noteConvention.classList.remove("visible");
    return;
  }
  if(info.sansTerme){
    valEl.innerHTML = "Non plafonnée<small> par une date</small>";
    noteSansTerme.classList.add("visible");
    noteConvention.classList.remove("visible");
    return;
  }
  noteSansTerme.classList.remove("visible");
  valEl.innerHTML = info.max + "<small> mois</small>";
  noteConvention.classList.toggle("visible", info.brancheAppliquee);
}

/* ---------- Bloc 2 : date de fin maximale + conformité ---------- */
function afficherBloc2(info){
  const el = document.getElementById("r-date-fin-max");
  const alerte = document.getElementById("alerte-depassement");
  const conforme = document.getElementById("note-conforme");

  if(!info){
    el.textContent = "Choisissez un motif";
    el.classList.add("vide");
    alerte.classList.remove("visible");
    conforme.style.display = "none";
    return;
  }
  if(info.sansTerme){
    el.textContent = "Sans objet — ce CDD n'a pas de terme précis";
    el.classList.add("vide");
    alerte.classList.remove("visible");
    conforme.style.display = "none";
    return;
  }
  const debut = parseDateInput(document.getElementById("date-debut").value);
  if(!debut){
    el.textContent = "Renseignez une date de début";
    el.classList.add("vide");
    alerte.classList.remove("visible");
    conforme.style.display = "none";
    return;
  }

  const finMax = veilleDe(ajouterMois(debut, info.max));
  el.textContent = formatDateFr(finMax);
  el.classList.remove("vide");

  const finEnvisageeStr = document.getElementById("date-fin-envisagee").value;
  const finEnvisagee = parseDateInput(finEnvisageeStr);
  if(!finEnvisagee){
    alerte.classList.remove("visible");
    conforme.style.display = "none";
    return;
  }
  if(finEnvisagee > finMax){
    const depassement = joursEntre(finMax, finEnvisagee);
    alerte.textContent = "⚠ La date de fin envisagée dépasse la durée maximale autorisée de " + depassement + " jour(s). La date de fin ne peut légalement pas dépasser le " + formatDateFr(finMax) + ".";
    alerte.classList.add("visible");
    conforme.style.display = "none";
  } else {
    alerte.classList.remove("visible");
    conforme.style.display = "block";
  }
}

/* ---------- Calcul global ---------- */
function calculerTout(){
  const info = calculerPlafond();
  afficherBloc1(info);
  afficherBloc2(info);
}

/* ---------- Câblage de l'interface ---------- */
document.getElementById("motif").addEventListener("change", () => {
  const motifKey = document.getElementById("motif").value;
  const motif = MOTIFS[motifKey];
  document.getElementById("etranger-wrap").style.display = (motif && motif.etrangerPossible) ? "flex" : "none";
  document.getElementById("terme-wrap").style.display = (motifKey === "saisonnier_usage") ? "block" : "none";
  calculerTout();
});

document.querySelectorAll("#terme-type .seg-btn").forEach(b => b.addEventListener("click", () => {
  termeType = b.dataset.terme;
  document.querySelectorAll("#terme-type .seg-btn").forEach(x => x.classList.toggle("active", x === b));
  calculerTout();
}));

document.getElementById("etranger").addEventListener("change", calculerTout);
document.getElementById("branche").addEventListener("input", calculerTout);
document.getElementById("date-debut").addEventListener("change", calculerTout);
document.getElementById("date-fin-envisagee").addEventListener("change", calculerTout);

calculerTout();
</script>
