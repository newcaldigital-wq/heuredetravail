<script is:inline>
/* Conversion heures:minutes <-> décimal. Pur calcul, aucune dépendance aux dates.
   Saisie décimale stricte (chiffres, une virgule ou un point) ; une saisie « 8h30 » ou « 8:30 » dans
   le champ décimal est reconnue et convertie directement. Résultats au point décimal (convention du
   site), arrondis à deux décimales ; « environ » / « ≈ » quand la valeur exacte est un nombre sans fin. */
const btnHM=document.getElementById("btn-hm"), btnDec=document.getElementById("btn-dec");
const modeHM=document.getElementById("mode-hm"), modeDec=document.getElementById("mode-dec");
const inH=document.getElementById("h-heures"), inM=document.getElementById("h-minutes"), inD=document.getElementById("d-decimal");
const rLbl=document.getElementById("r-lbl"), rVal=document.getElementById("r-val"), rHint=document.getElementById("r-hint");
let sens="hm";

function decPt(d){return d.toFixed(2);}
function exact2(d){return Math.abs(d*100-Math.round(d*100))<1e-9;}
function lireHM(s){const m=String(s).trim().match(/^(\d{1,4})\s*[hH:]\s*(\d{1,2})$/);return m?{h:+m[1],m:+m[2]}:null;}
function lireDec(s){const t=String(s).trim();if(!/^(\d+([.,]\d*)?|[.,]\d+)$/.test(t))return NaN;return parseFloat(t.replace(",","."));}
function vide(lbl,txt){rLbl.textContent=lbl;rVal.innerHTML="—";rHint.textContent=txt;}

function calculerHM(){
  const hv=String(inH.value).trim(), mv=String(inM.value).trim();
  rLbl.textContent="Résultat en décimal";
  if(hv===""&&mv===""){vide("Résultat en décimal","Saisissez des heures et des minutes (ex. 8 h 30).");return;}
  let h=hv===""?0:Number(hv), m=mv===""?0:Number(mv);
  if(!Number.isFinite(h)||!Number.isFinite(m)||h<0||m<0){vide("Résultat en décimal","Les heures et les minutes doivent être des nombres positifs.");return;}
  if(!Number.isInteger(h)||!Number.isInteger(m)){vide("Résultat en décimal","Saisissez des heures et des minutes entières. Pour convertir une valeur décimale, utilisez l'autre sens.");return;}
  let note="";
  if(m>59){note=" ("+m+" minutes ramenées à "+Math.floor(m/60)+" h "+String(m%60).padStart(2,"0")+")";h+=Math.floor(m/60);m=m%60;}
  const dec=h+m/60, ex=exact2(m/60);
  rVal.innerHTML=decPt(dec)+"<small> h</small>";
  rHint.textContent=h+" h "+String(m).padStart(2,"0")+note+" équivaut à "+(ex?"":"environ ")+decPt(dec)+" en décimal — les "+m+" minutes comptent pour "+decPt(m/60)+" ("+m+" ÷ 60"+(ex?"":", arrondi")+").";
}
function calculerDec(){
  const v=String(inD.value).trim();
  if(v===""){vide("Résultat en heures:minutes","Saisissez une valeur décimale positive (ex. 8,5 ou 8.5).");return;}
  const hm=lireHM(v);
  if(hm&&hm.m<60){
    const dec=hm.h+hm.m/60;
    rLbl.textContent="Résultat en décimal";
    rVal.innerHTML=decPt(dec)+"<small> h</small>";
    rHint.textContent="« "+v+" » est déjà en heures:minutes : "+hm.h+" h "+String(hm.m).padStart(2,"0")+" équivaut à "+(exact2(hm.m/60)?"":"environ ")+decPt(dec)+" en décimal. Pour convertir une valeur décimale en heures:minutes, saisissez-la avec une virgule ou un point (ex. 8,5).";
    return;
  }
  const dec=lireDec(v);
  if(isNaN(dec)){vide("Résultat en heures:minutes","Saisissez une valeur décimale positive, avec une virgule ou un point (ex. 8,5 ou 8.5).");return;}
  const hp=Math.floor(dec+1e-9),frac=dec-hp,minBrut=frac*60;
  let h=hp,m=Math.round(minBrut);const ex=Math.abs(minBrut-m)<1e-6;
  let report="";
  if(m===60){h++;m=0;report=", arrondi à l'heure suivante";}
  rLbl.textContent="Résultat en heures:minutes";
  rVal.innerHTML=h+"h"+String(m).padStart(2,"0")+"<small> ("+h+" h "+m+" min)</small>";
  const fracTxt=String(+frac.toFixed(4)),decTxt=v.replace(",",".");
  rHint.textContent=decTxt+" en décimal équivaut à "+(ex?"":"environ ")+h+"h"+String(m).padStart(2,"0")+" — "+hp+" heure"+(hp>1?"s":"")+" pleine"+(hp>1?"s":"")+", et "+fracTxt+" × 60 "+(ex?"= ":"≈ ")+(report?"60":m)+" minutes"+report+".";
}
function calculer(){ if(sens==="hm") calculerHM(); else calculerDec(); }

function basculer(nouveauSens){
  sens=nouveauSens;
  if(sens==="hm"){
    btnHM.classList.add("actif"); btnDec.classList.remove("actif");
    modeHM.classList.add("actif"); modeDec.classList.remove("actif");
  }else{
    btnDec.classList.add("actif"); btnHM.classList.remove("actif");
    modeDec.classList.add("actif"); modeHM.classList.remove("actif");
  }
  calculer();
}

btnHM.addEventListener("click",()=>basculer("hm"));
btnDec.addEventListener("click",()=>basculer("dec"));
[inH,inM].forEach(el=>el.addEventListener("input",calculer));
inD.addEventListener("input",calculer);

calculer();
</script>

