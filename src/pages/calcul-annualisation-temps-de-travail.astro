<script is:inline>
/* Dates manipulées en UTC (minuit UTC) : aucun effet du fuseau horaire ni
   des changements d'heure du navigateur sur le décompte des jours. */
const MS_JOUR = 86400000;
const ANNEE_MIN = 1900, ANNEE_MAX = 2100;
const COURTE_PERIODE = 28; // en dessous, le prorata calendaire est peu significatif

function dateU(annee, moisIndex, jour){
  return new Date(Date.UTC(annee, moisIndex, jour));
}

function parseDate(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  if(!a || !m || !j) return null;
  const d = dateU(a, m-1, j);
  d.setUTCFullYear(a); // évite l'interprétation 0050 -> 1950
  return d;
}

function anneeHorsBornes(d){
  return d.getUTCFullYear() < ANNEE_MIN || d.getUTCFullYear() > ANNEE_MAX;
}

/* Lendemain du dernier jour d'une période de 12 mois commençant à "debut"
   (même quantième l'année suivante ; 29 février -> 1er mars). */
function anniversaire(debut){
  return dateU(debut.getUTCFullYear() + 1, debut.getUTCMonth(), debut.getUTCDate());
}

function joursEntre(debut, finExclue){
  return Math.round((finExclue.getTime() - debut.getTime()) / MS_JOUR);
}

const MSG_ORDRE = "La date de fin doit être postérieure ou égale à la date de début.";
const MSG_INVALIDE = "Date invalide : vérifiez que le jour saisi existe bien dans le mois choisi.";
const MSG_BORNES = "Saisissez des dates comprises entre 1900 et 2100.";
const MSG_ANNEE_VIDE = "Saisissez l'année de référence.";
const MSG_ANNEE_BORNES = "Saisissez une année comprise entre 1900 et 2100.";
const MSG_12_MOIS = "La période ne peut pas dépasser 12 mois. Pour une période de référence supérieure à un an, le seuil n'est plus 1607h mais une moyenne de 35h par semaine sur la période (art. L3121-41) : ce cas n'est pas traité ici.";
const MSG_PLAFOND = "Le seuil ne peut pas dépasser 1607 heures pour un temps complet (art. L3121-41). Seule une limite inférieure peut être fixée par accord (art. L3121-44).";
const MSG_PLAFOND_NUL = "Saisissez un seuil annuel supérieur à 0.";
const MSG_VOLUME = "Le volume prévu ne peut pas être négatif.";
const MSG_COURTE = "Sur une période aussi courte, le prorata calendaire du seuil est peu significatif : le résultat n'est qu'un ordre de grandeur.";

function arrondi1(n){
  return Math.round(n * 10) / 10;
}

function basculerBlocsPeriode(){
  const type = document.getElementById("type-periode").value;
  document.getElementById("bloc-complete").style.display = (type === "complete") ? "block" : "none";
  document.getElementById("bloc-incomplete").style.display = (type === "incomplete") ? "block" : "none";
}

function viderResultatVolume(){
  document.getElementById("r-volume").textContent = "—";
  document.getElementById("r-ecart").textContent = "—";
  document.getElementById("r-statut").textContent = "—";
  document.getElementById("carte-ecart").className = "carte info";
}

function afficherVide(){
  document.getElementById("r-plafond").textContent = "—";
  viderResultatVolume();
}

function montrerErreur(msg){
  const e = document.getElementById("erreur-msg");
  e.textContent = msg;
  e.classList.add("visible");
}

function montrerInfo(msg){
  const e = document.getElementById("info-msg");
  e.textContent = msg;
  e.classList.add("visible");
}

function calculer(){
  document.getElementById("erreur-msg").classList.remove("visible");
  document.getElementById("info-msg").classList.remove("visible");

  const typePeriode = document.getElementById("type-periode").value;

  /* Seuil annuel : champ vide (aucun message) distingué d'une valeur saisie
     mais inexploitable (message). */
  const inpPlafond = document.getElementById("plafond");
  const plafondStr = inpPlafond.value.trim();
  const plafondSaisi = parseFloat(plafondStr);
  if(inpPlafond.validity.badInput || (plafondStr !== "" && (isNaN(plafondSaisi) || plafondSaisi <= 0))){
    montrerErreur(MSG_PLAFOND_NUL);
    afficherVide();
    return;
  }
  if(plafondStr !== "" && plafondSaisi > 1607){
    montrerErreur(MSG_PLAFOND);
    afficherVide();
    return;
  }
  const plafondValide = plafondStr !== "";

  if(!typePeriode){
    afficherVide();
    return;
  }

  let ratio = 1, jCal = null;

  if(typePeriode === "complete"){
    const inpAnnee = document.getElementById("annee-ref");
    if(inpAnnee.value.trim() === "" || inpAnnee.validity.badInput){
      montrerErreur(MSG_ANNEE_VIDE);
      afficherVide();
      return;
    }
    const annee = parseInt(inpAnnee.value, 10);
    if(isNaN(annee) || annee < ANNEE_MIN || annee > ANNEE_MAX){
      montrerErreur(MSG_ANNEE_BORNES);
      afficherVide();
      return;
    }
  } else {
    const inpDebut = document.getElementById("date-debut");
    const inpFin = document.getElementById("date-fin");
    if(inpDebut.validity.badInput || inpFin.validity.badInput){
      montrerErreur(MSG_INVALIDE);
      afficherVide();
      return;
    }
    const debut = parseDate(inpDebut.value);
    const fin = parseDate(inpFin.value);
    if(!debut || !fin){
      afficherVide();
      return;
    }
    if(anneeHorsBornes(debut) || anneeHorsBornes(fin)){
      montrerErreur(MSG_BORNES);
      afficherVide();
      return;
    }
    if(fin < debut){
      montrerErreur(MSG_ORDRE);
      afficherVide();
      return;
    }
    const anniv = anniversaire(debut);
    if(fin >= anniv){
      montrerErreur(MSG_12_MOIS);
      afficherVide();
      return;
    }
    /* Prorata calendaire, dates incluses, rapporté aux 12 mois qui suivent
       la date de début (12 mois complets = ratio 1, même avec un 29 février). */
    jCal = joursEntre(debut, fin) + 1;
    ratio = jCal / joursEntre(debut, anniv);
  }

  if(!plafondValide){
    afficherVide();
    return;
  }

  const plafondApplicable = arrondi1(plafondSaisi * ratio);
  document.getElementById("r-plafond").innerHTML = plafondApplicable + "<small> h</small>";
  if(jCal !== null && jCal < COURTE_PERIODE) montrerInfo(MSG_COURTE);

  const inpVol = document.getElementById("volume-annuel");
  const volStr = inpVol.value.trim();
  const vol = parseFloat(volStr);
  if(volStr === "" && !inpVol.validity.badInput){
    viderResultatVolume();
    return;
  }
  if(inpVol.validity.badInput || isNaN(vol) || vol < 0){
    montrerErreur(MSG_VOLUME);
    viderResultatVolume();
    return;
  }

  const volAffiche = arrondi1(vol);
  document.getElementById("r-volume").innerHTML = volAffiche + "<small> h</small>";

  /* L'écart et le statut sont calculés sur les valeurs affichées, pour
     rester cohérents entre eux. */
  const ecart = arrondi1(volAffiche - plafondApplicable);
  const carteEcart = document.getElementById("carte-ecart");

  if(ecart > 0){
    document.getElementById("r-ecart").innerHTML = "+" + ecart + "<small> h</small>";
    document.getElementById("r-statut").textContent = "Au-delà du seuil : " + ecart + " h d'heures supplémentaires";
    carteEcart.className = "carte alerte-carte";
  } else {
    document.getElementById("r-ecart").innerHTML = ecart + "<small> h</small>";
    document.getElementById("r-statut").textContent = "Sous le seuil : pas d'heures supplémentaires";
    carteEcart.className = "carte principal";
  }
}

document.getElementById("plafond").addEventListener("input", calculer);
document.getElementById("volume-annuel").addEventListener("input", calculer);
document.getElementById("type-periode").addEventListener("change", () => { basculerBlocsPeriode(); calculer(); });
document.getElementById("annee-ref").addEventListener("input", calculer);
document.getElementById("date-debut").addEventListener("change", calculer);
document.getElementById("date-fin").addEventListener("change", calculer);
document.getElementById("date-debut").addEventListener("input", calculer);
document.getElementById("date-fin").addEventListener("input", calculer);

document.getElementById("vider").addEventListener("click", () => {
  document.getElementById("plafond").value = "1607";
  document.getElementById("volume-annuel").value = "";
  document.getElementById("type-periode").value = "";
  document.getElementById("annee-ref").value = "2026";
  document.getElementById("date-debut").value = "";
  document.getElementById("date-fin").value = "";
  basculerBlocsPeriode();
  calculer();
});

basculerBlocsPeriode();
</script>
</body>
</html>
