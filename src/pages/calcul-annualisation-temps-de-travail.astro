<script is:inline>
function estBissextile(a){
  return (a % 4 === 0 && a % 100 !== 0) || (a % 400 === 0);
}
function joursDansAnnee(a){
  return estBissextile(a) ? 366 : 365;
}

function parseDate(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  return new Date(a, m-1, j);
}

function joursCalendairesEntre(debut, fin){
  const msParJour = 24*60*60*1000;
  return Math.round((fin - debut) / msParJour) + 1;
}

const MSG_ORDRE = "La date de fin doit être postérieure ou égale à la date de début.";
const MSG_INVALIDE = "Date invalide : vérifiez que le jour saisi existe bien dans le mois choisi.";
const MSG_PLAFOND = "Le plafond ne peut pas dépasser 1607 heures pour un temps complet (art. L3121-41). Seule une limite inférieure peut être fixée par accord (art. L3121-44).";

function arrondi1(n){
  return Math.round(n * 10) / 10;
}

function basculerBlocsPeriode(){
  const type = document.getElementById("type-periode").value;
  document.getElementById("bloc-complete").style.display = (type === "complete") ? "block" : "none";
  document.getElementById("bloc-incomplete").style.display = (type === "incomplete") ? "block" : "none";
}

function afficherVide(){
  document.getElementById("r-plafond").textContent = "—";
  document.getElementById("r-volume").textContent = "—";
  document.getElementById("r-ecart").textContent = "—";
  document.getElementById("r-statut").textContent = "—";
  document.getElementById("carte-ecart").className = "carte info";
}

function calculer(){
  const erreur = document.getElementById("erreur-msg");
  erreur.classList.remove("visible");

  const typePeriode = document.getElementById("type-periode").value;

  const plafondStr = document.getElementById("plafond").value;
  const plafondSaisi = parseFloat(plafondStr);
  const plafondValide = !!plafondStr && !isNaN(plafondSaisi) && plafondSaisi > 0;

  if(plafondValide && plafondSaisi > 1607){
    erreur.textContent = MSG_PLAFOND;
    erreur.classList.add("visible");
    afficherVide();
    return;
  }

  if(!typePeriode){
    afficherVide();
    return;
  }

  let debut, fin, ratio = 1;

  if(typePeriode === "complete"){
    const annee = parseInt(document.getElementById("annee-ref").value, 10) || new Date().getFullYear();
    debut = new Date(annee, 0, 1);
    fin = new Date(annee, 11, 31);
  } else {
    const inpDebut = document.getElementById("date-debut");
    const inpFin = document.getElementById("date-fin");

    if(inpDebut.validity.badInput || inpFin.validity.badInput){
      erreur.textContent = MSG_INVALIDE;
      erreur.classList.add("visible");
      afficherVide();
      return;
    }

    debut = parseDate(inpDebut.value);
    fin = parseDate(inpFin.value);

    if(!debut || !fin){
      afficherVide();
      return;
    }
    if(fin < debut){
      erreur.textContent = MSG_ORDRE;
      erreur.classList.add("visible");
      afficherVide();
      return;
    }
  }

  const jCal = joursCalendairesEntre(debut, fin);
  const anneeRef = debut.getFullYear();
  const joursAnnee = joursDansAnnee(anneeRef);
  ratio = (typePeriode === "complete") ? 1 : (jCal / joursAnnee);

  if(!plafondValide){
    afficherVide();
    return;
  }

  const plafondApplicable = plafondSaisi * ratio;
  document.getElementById("r-plafond").innerHTML = arrondi1(plafondApplicable) + "<small> h</small>";

  const volStr = document.getElementById("volume-annuel").value;
  const vol = parseFloat(volStr);
  const volumeValide = !!volStr && !isNaN(vol) && vol >= 0;

  if(!volumeValide){
    document.getElementById("r-volume").textContent = "—";
    document.getElementById("r-ecart").textContent = "—";
    document.getElementById("r-statut").textContent = "—";
    document.getElementById("carte-ecart").className = "carte info";
    return;
  }

  document.getElementById("r-volume").innerHTML = arrondi1(vol) + "<small> h</small>";

  const ecart = vol - plafondApplicable;
  const carteEcart = document.getElementById("carte-ecart");

  if(ecart > 0.05){
    document.getElementById("r-ecart").innerHTML = "+" + arrondi1(ecart) + "<small> h</small>";
    document.getElementById("r-statut").textContent = "Dépassement du plafond";
    carteEcart.className = "carte alerte-carte";
  } else {
    document.getElementById("r-ecart").innerHTML = arrondi1(ecart) + "<small> h</small>";
    document.getElementById("r-statut").textContent = "Conforme au plafond";
    carteEcart.className = "carte principal";
  }
}

document.getElementById("plafond").addEventListener("input", calculer);
document.getElementById("volume-annuel").addEventListener("input", calculer);
document.getElementById("type-periode").addEventListener("change", () => { basculerBlocsPeriode(); calculer(); });
document.getElementById("annee-ref").addEventListener("input", calculer);
document.getElementById("date-debut").addEventListener("change", calculer);
document.getElementById("date-fin").addEventListener("change", calculer);
document.getElementById("date-debut").addEventListener("input", calculer);
document.getElementById("date-fin").addEventListener("input", calculer);

document.getElementById("vider").addEventListener("click", () => {
  document.getElementById("plafond").value = "1607";
  document.getElementById("volume-annuel").value = "";
  document.getElementById("type-periode").value = "";
  document.getElementById("annee-ref").value = "2026";
  document.getElementById("date-debut").value = "";
  document.getElementById("date-fin").value = "";
  basculerBlocsPeriode();
  afficherVide();
});

basculerBlocsPeriode();
</script>
</body>
</html>
