<script is:inline>
/* ---------- Fonctions de date ---------- */
/* Ajout de mois plafonné au dernier jour du mois : utilisé pour l'ancienneté. */
function ajouterMois(date, n){
  const d = new Date(date.getFullYear(), date.getMonth() + n, date.getDate());
  if(d.getDate() !== date.getDate()){
    return new Date(date.getFullYear(), date.getMonth() + n + 1, 0);
  }
  return d;
}
function veilleDe(date){
  const d = new Date(date);
  d.setDate(d.getDate() - 1);
  return d;
}
function lendemainDe(date){
  const d = new Date(date);
  d.setDate(d.getDate() + 1);
  return d;
}
/* Préavis en mois : décompte "de date à date" (délai préfix, service-public.fr F2855),
   fin la veille de la date anniversaire, jour de notification compté comme jour 1.
   Quantième inexistant dans le mois d'arrivée (ex. 31 mars + 1 mois) : aucun texte ni
   arrêt ne tranche ; l'art. 641 CPC a été jugé « inapplicable pour le calcul de
   l'indemnité de préavis » (Cass. soc., 23 juin 2004, n° 02-42.601, inédit ; litige
   sur le paiement d'un dernier jour de préavis) — arrêt qui conforte ce choix sans
   trancher le cas du quantième inexistant. L'outil retient le dernier jour du mois
   (30 avril) : une fin trop tardive d'un jour ne fait courir de risque à aucune partie,
   une fin trop précoce expose à une indemnité de préavis non exécuté.
   Choix VOLONTAIREMENT INVERSE de la période d'essai et de la durée du CDD (veille du
   dernier jour du mois), où la date prudente est la plus précoce. */
function finPreavisMois(debut, n){
  const jour = debut.getDate();
  const cible = new Date(debut.getFullYear(), debut.getMonth() + n, jour);
  if(cible.getDate() !== jour){
    return new Date(debut.getFullYear(), debut.getMonth() + n + 1, 0);
  }
  return veilleDe(cible);
}
function ajouterJoursCalendaires(debut, n){
  const d = new Date(debut);
  d.setDate(d.getDate() + n);
  return d;
}
/* Jours calendaires : le jour de début compte comme jour 1 */
function finPreavisJoursCalendaires(debut, n){
  return ajouterJoursCalendaires(debut, n - 1);
}
function estJourOuvre(d){
  const j = d.getDay();
  return j !== 0 && j !== 6;
}
/* Jours ouvrables : tous les jours sauf le dimanche */
function estJourOuvrable(d){
  return d.getDay() !== 0;
}
/* Compte n jours "comptés" à partir de debut (debut = jour 1 s'il est compté, sinon le
   premier jour compté suivant). Jours fériés non gérés : méthode propre à l'outil,
   signalée dans l'avertissement en bas de page. */
function finParJoursComptes(debut, n, estCompte){
  let d = new Date(debut);
  let compte = 0;
  while(true){
    if(estCompte(d)){
      compte++;
      if(compte === n) return d;
    }
    d.setDate(d.getDate() + 1);
  }
}
function compterJoursComptes(debut, finIncluse, estCompte){
  let d = new Date(debut);
  let compte = 0;
  while(d <= finIncluse){
    if(estCompte(d)) compte++;
    d.setDate(d.getDate() + 1);
  }
  return compte;
}
function ajouterSemaines(debut, n){
  return ajouterJoursCalendaires(debut, n * 7 - 1);
}
/* Ancienneté en mois entiers, par ajout de mois plafonné (même moteur que le calculateur
   d'ancienneté du site). */
function totalMoisAnciennete(debut, fin){
  const approx = (fin.getFullYear() - debut.getFullYear()) * 12 + (fin.getMonth() - debut.getMonth());
  let totalMois = approx;
  let candidat = ajouterMois(debut, totalMois);
  if(candidat > fin){
    totalMois -= 1;
  } else {
    let suivant = ajouterMois(debut, totalMois + 1);
    while(suivant <= fin){
      totalMois += 1;
      suivant = ajouterMois(debut, totalMois + 1);
    }
  }
  return totalMois;
}
function parseDateInput(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  return new Date(a, m-1, j);
}
function formatDateFr(d){
  const jours = ["dimanche","lundi","mardi","mercredi","jeudi","vendredi","samedi"];
  const mois = ["janvier","février","mars","avril","mai","juin","juillet","août","septembre","octobre","novembre","décembre"];
  return jours[d.getDay()] + " " + d.getDate() + " " + mois[d.getMonth()] + " " + d.getFullYear();
}
function formatAnciennete(totalMois){
  const annees = Math.floor(totalMois / 12);
  const mois = totalMois % 12;
  const parts = [];
  if(annees > 0) parts.push(annees + (annees === 1 ? " an" : " ans"));
  parts.push(mois + " mois");
  return parts.join(", ");
}
function joursEntre(d1, d2){
  return Math.round((d2 - d1) / 86400000);
}

/* ---------- Durées ---------- */
/* Lit une durée saisie (nombre + unité + type de jours). Renvoie :
   - null tant qu'une information manque (aucune date "par défaut") ;
   - { erreur } si le nombre n'est pas un entier positif ;
   - { n, type } sinon, type ∈ mois | semaines | calendaires | ouvres | ouvrables. */
function lireDuree(inputNombre, unite, modeJours){
  if(inputNombre && inputNombre.validity && inputNombre.validity.badInput){
    return { erreur: "Durée invalide : saisissez un nombre entier (ex. 1, 2, 15)." };
  }
  const brut = (inputNombre ? inputNombre.value : "").trim();
  if(brut === "") return null;
  if(!/^\d+$/.test(brut)){
    return { erreur: "Durée invalide : saisissez un nombre entier (ex. 1, 2, 15)." };
  }
  const n = parseInt(brut, 10);
  if(n <= 0) return { erreur: "Durée invalide : la durée doit être d'au moins 1." };
  if(!unite) return null;
  if(unite === "mois" || unite === "semaines") return { n, type: unite };
  if(unite === "jours"){
    if(!modeJours) return null;
    return { n, type: modeJours };
  }
  return null;
}
function finDepuis(debut, duree){
  if(duree.type === "mois") return finPreavisMois(debut, duree.n);
  if(duree.type === "semaines") return ajouterSemaines(debut, duree.n);
  if(duree.type === "ouvres") return finParJoursComptes(debut, duree.n, estJourOuvre);
  if(duree.type === "ouvrables") return finParJoursComptes(debut, duree.n, estJourOuvrable);
  return finPreavisJoursCalendaires(debut, duree.n);
}

/* ---------- Congés payés posés avant la notification ----------
   Règle : les congés fixés avant la notification suspendent le préavis, qui reprend à leur
   issue (service-public.fr, fiches F2855 et F2930).
   - Notification pendant les congés : le préavis ne commence qu'au lendemain de leur fin.
   - Congés commençant pendant le préavis : le préavis est suspendu du premier au dernier
     jour de congés (même au-delà de la fin initialement prévue), puis reprend pour la durée
     restante. Mois / semaines / jours calendaires : prolongation d'une durée calendaire
     équivalente. Jours ouvrés / ouvrables : les jours restants sont décomptés à partir du
     lendemain des congés.
   - Congés terminés avant la notification ou commençant après la fin du préavis : sans effet. */
function calculerFinAvecConges(debutPreavis, duree, congesSelect, cdStr, cfStr){
  const finNaive = finDepuis(debutPreavis, duree);
  if(congesSelect !== "oui") return { fin: finNaive };
  const cd = parseDateInput(cdStr);
  const cf = parseDateInput(cfStr);
  if(!cd || !cf) return { fin: finNaive };
  if(cf < cd) return { fin: finNaive, erreurOrdre: true };

  if(cd <= debutPreavis && cf >= debutPreavis){
    const reprise = lendemainDe(cf);
    return { fin: finDepuis(reprise, duree), congesAppliques: true, notifPendantConges: true, reprise };
  }
  if(cd > debutPreavis && cd <= finNaive){
    const nbJoursConges = joursEntre(cd, cf) + 1;
    const reprise = lendemainDe(cf);
    let fin;
    if(duree.type === "ouvres" || duree.type === "ouvrables"){
      const estCompte = duree.type === "ouvres" ? estJourOuvre : estJourOuvrable;
      const dejaEcoules = compterJoursComptes(debutPreavis, veilleDe(cd), estCompte);
      fin = finParJoursComptes(reprise, duree.n - dejaEcoules, estCompte);
    } else {
      fin = ajouterJoursCalendaires(finNaive, nbJoursConges);
    }
    return { fin, congesAppliques: true, suspension: true, cd, cf, nbJoursConges };
  }
  return { fin: finNaive, horsPeriode: true };
}

function detecterBadInput(...inputs){
  return inputs.some(i => i && i.validity && i.validity.badInput);
}

/* ---------- État ---------- */
let typeRupture = "demission";

/* ---------- Câblage : type de rupture ---------- */
document.querySelectorAll("#type-rupture .seg-btn").forEach(b => b.addEventListener("click", () => {
  typeRupture = b.dataset.type;
  document.querySelectorAll("#type-rupture .seg-btn").forEach(x => x.classList.toggle("active", x === b));
  document.getElementById("bloc-motif-licenciement").style.display = typeRupture === "licenciement" ? "block" : "none";
  document.getElementById("panneau-demission").style.display = typeRupture === "demission" ? "block" : "none";
  document.getElementById("panneau-licenciement").style.display = typeRupture === "licenciement" ? "block" : "none";
  calculerTout();
}));

/* ---------- Câblage : sous-champs conditionnels ---------- */
function cablerUnite(idUnite, idModeWrap){
  document.getElementById(idUnite).addEventListener("change", function(){
    document.getElementById(idModeWrap).style.display = this.value === "jours" ? "flex" : "none";
    calculerTout();
  });
}
cablerUnite("dem-unite", "dem-mode-jours-wrap");
cablerUnite("lic-unite-libre", "lic-mode-jours-libre-wrap");
cablerUnite("lic-unite-conv", "lic-mode-jours-conv-wrap");

function cablerConges(idSelect, idDatesWrap, idHint){
  document.getElementById(idSelect).addEventListener("change", function(){
    const show = this.value === "oui";
    document.getElementById(idDatesWrap).style.display = show ? "flex" : "none";
    document.getElementById(idHint).style.display = show ? "block" : "none";
    calculerTout();
  });
}
cablerConges("dem-conges-select", "dem-conges-dates-wrap", "dem-hint-conges");
cablerConges("lic-conges-select", "lic-conges-dates-wrap", "lic-hint-conges");

document.getElementById("faute-grave").addEventListener("change", calculerTout);
document.getElementById("lic-convention-check").addEventListener("change", function(){
  document.getElementById("lic-convention-wrap").style.display = this.checked ? "flex" : "none";
  calculerTout();
});

["dem-date-notif","dem-duree","dem-unite","dem-mode-jours","dem-conges-select","dem-conges-debut","dem-conges-fin"].forEach(id => {
  const el = document.getElementById(id);
  el.addEventListener("change", calculerTout);
  el.addEventListener("input", calculerTout);
});
["lic-date-entree","lic-date-envoi","lic-date-notif","lic-duree-libre","lic-unite-libre","lic-mode-jours-libre",
 "lic-duree-conv","lic-unite-conv","lic-mode-jours-conv","lic-conges-select","lic-conges-debut","lic-conges-fin"].forEach(id => {
  const el = document.getElementById(id);
  el.addEventListener("change", calculerTout);
  el.addEventListener("input", calculerTout);
});

const MSG_DATE_INVALIDE = "Date invalide : vérifiez que le jour saisi existe bien dans le mois choisi.";

function appliquerConges(debut, duree, prefixe){
  const congesSelect = document.getElementById(prefixe + "-conges-select").value;
  const inpCd = document.getElementById(prefixe + "-conges-debut");
  const inpCf = document.getElementById(prefixe + "-conges-fin");
  if(congesSelect === "oui" && detecterBadInput(inpCd, inpCf)){
    return { fin: finDepuis(debut, duree), congesErreur: MSG_DATE_INVALIDE };
  }
  return calculerFinAvecConges(debut, duree, congesSelect, inpCd.value, inpCf.value);
}

/* ---------- Calcul : bloc démission ---------- */
function calculerDemission(){
  const inpDate = document.getElementById("dem-date-notif");
  if(detecterBadInput(inpDate)) return { erreur: MSG_DATE_INVALIDE };
  const debut = parseDateInput(inpDate.value);
  const duree = lireDuree(document.getElementById("dem-duree"),
                          document.getElementById("dem-unite").value,
                          document.getElementById("dem-mode-jours").value);
  if(duree && duree.erreur) return { erreur: duree.erreur };
  if(!debut || !duree) return { fin: null };
  return appliquerConges(debut, duree, "dem");
}

/* ---------- Calcul : bloc licenciement ---------- */
function calculerLicenciement(){
  const fauteGrave = document.getElementById("faute-grave").value;
  if(fauteGrave === "oui") return { fauteGrave: true };
  if(!fauteGrave) return { motifNonChoisi: true };

  const inpEntree = document.getElementById("lic-date-entree");
  const inpEnvoi = document.getElementById("lic-date-envoi");
  const inpNotif = document.getElementById("lic-date-notif");
  if(detecterBadInput(inpEntree, inpEnvoi, inpNotif)) return { erreur: MSG_DATE_INVALIDE };
  const entree = parseDateInput(inpEntree.value);
  const envoi = parseDateInput(inpEnvoi.value);
  const presentation = parseDateInput(inpNotif.value);

  /* L'ancienneté (et donc le palier) ne dépend que de l'entrée et de l'envoi */
  if(!entree || !envoi) return { anciennete: null };
  if(envoi < entree) return { erreurOrdre: "⚠ La date d'entrée est postérieure à la date d'envoi de la lettre. Vérifiez les dates saisies." };
  if(presentation && presentation < envoi) return { erreurOrdre: "⚠ La date de première présentation est antérieure à la date d'envoi de la lettre. Vérifiez les dates saisies." };

  const totalMois = totalMoisAnciennete(entree, envoi);
  let palier, dureeLegaleLabel;
  if(totalMois < 6){
    palier = "libre"; dureeLegaleLabel = "Non fixé par la loi";
  } else if(totalMois < 24){
    palier = "un_mois"; dureeLegaleLabel = "1 mois";
  } else {
    palier = "deux_mois"; dureeLegaleLabel = "2 mois";
  }
  const base = { totalMois, palier, dureeLegaleLabel };

  let duree = null;
  let convPlusCourte = false;
  if(palier === "libre"){
    duree = lireDuree(document.getElementById("lic-duree-libre"),
                      document.getElementById("lic-unite-libre").value,
                      document.getElementById("lic-mode-jours-libre").value);
    if(duree && duree.erreur) return Object.assign(base, { erreurDuree: duree.erreur });
  } else {
    duree = { n: palier === "un_mois" ? 1 : 2, type: "mois" };
    if(document.getElementById("lic-convention-check").checked){
      const conv = lireDuree(document.getElementById("lic-duree-conv"),
                             document.getElementById("lic-unite-conv").value,
                             document.getElementById("lic-mode-jours-conv").value);
      if(conv && conv.erreur) return Object.assign(base, { erreurDuree: conv.erreur });
      /* La durée conventionnelle ne s'applique que si elle est plus longue que le
         minimum légal (comparaison sur la date de fin, unités différentes possibles). */
      if(conv && presentation){
        if(finDepuis(presentation, conv) > finDepuis(presentation, duree)) duree = conv;
        else convPlusCourte = true;
      }
    }
  }
  if(!presentation || !duree) return Object.assign(base, { fin: null, convPlusCourte });
  const c = appliquerConges(presentation, duree, "lic");
  return Object.assign(base, c, { convPlusCourte });
}

/* ---------- Affichage ---------- */
function afficherResultat(fin, texteVide, c){
  const el = document.getElementById("r-date-fin");
  const noteConges = document.getElementById("note-conges");
  if(!fin){
    el.textContent = texteVide;
    el.classList.add("vide");
    noteConges.style.display = "none";
    return;
  }
  el.textContent = formatDateFr(fin);
  el.classList.remove("vide");
  const finCommun = " Si vos congés ont été posés <b>après</b> la notification, d'un commun accord, ils ne suspendent pas le préavis : la date ci-dessus ne s'applique alors pas.";
  if(c && c.notifPendantConges){
    noteConges.innerHTML = "La notification est intervenue pendant des congés payés posés auparavant : le préavis ne commence à courir qu'à leur issue, le " + formatDateFr(c.reprise) + ", et la date ci-dessus est calculée à partir de ce jour." + finCommun;
    noteConges.style.display = "block";
  } else if(c && c.suspension){
    noteConges.innerHTML = "Le préavis est suspendu pendant les congés payés (du " + formatDateFr(c.cd) + " au " + formatDateFr(c.cf) + ", soit " + c.nbJoursConges + " jour(s) calendaire(s)), puis reprend à leur issue pour la durée restante. La date ci-dessus intègre cette suspension." + finCommun;
    noteConges.style.display = "block";
  } else if(c && c.horsPeriode){
    noteConges.textContent = "Les congés indiqués ne recoupent pas la période de préavis (terminés avant la notification, ou commençant après la fin du préavis) : ils n'ont donc aucun effet sur la date de fin ci-dessus.";
    noteConges.style.display = "block";
  } else {
    noteConges.style.display = "none";
  }
}

function majAlerteConges(id, r){
  const el = document.getElementById(id);
  if(r.congesErreur){
    el.textContent = "⚠ " + r.congesErreur;
    el.classList.add("visible");
  } else if(r.erreurOrdre === true){
    el.textContent = "⚠ La date de fin des congés est antérieure à la date de début. Vérifiez les dates saisies.";
    el.classList.add("visible");
  } else {
    el.classList.remove("visible");
  }
}

function calculerTout(){
  const alerteFaute = document.getElementById("alerte-faute-grave");
  document.getElementById("r-lbl").textContent = "Le préavis se termine le";

  if(typeRupture === "demission"){
    alerteFaute.classList.remove("visible");
    document.getElementById("lic-alerte-dates").classList.remove("visible");
    const r = calculerDemission();
    if(r.erreur){
      document.getElementById("dem-alerte-conges").classList.remove("visible");
      afficherResultat(null, r.erreur, null);
      return;
    }
    majAlerteConges("dem-alerte-conges", r);
    afficherResultat(r.fin, "Complétez la date, la durée et l'unité du préavis", r);
    return;
  }

  /* --- Licenciement --- */
  const rAnc = document.getElementById("lic-r-anciennete");
  const rPalier = document.getElementById("lic-r-palier");
  const blocLibre = document.getElementById("lic-bloc-libre");
  const blocFixe = document.getElementById("lic-bloc-fixe");
  const licCorps = document.getElementById("lic-corps");
  const alerteOrdre = document.getElementById("lic-alerte-dates");
  const alerteConv = document.getElementById("lic-alerte-conv");
  const alerteConges = document.getElementById("lic-alerte-conges");

  function reinitialiser(){
    rAnc.textContent = "—"; rPalier.textContent = "—";
    blocLibre.style.display = "none"; blocFixe.style.display = "none";
    alerteConv.classList.remove("visible");
    alerteConges.classList.remove("visible");
  }

  const r = calculerLicenciement();

  if(r.fauteGrave){
    alerteFaute.classList.add("visible");
    licCorps.style.display = "none";
    afficherResultat(null, "Aucun préavis n'est dû", null);
    return;
  }
  alerteFaute.classList.remove("visible");
  licCorps.style.display = "block";

  if(r.motifNonChoisi){
    reinitialiser(); alerteOrdre.classList.remove("visible");
    afficherResultat(null, "Choisissez d'abord le motif du licenciement", null);
    return;
  }
  if(r.erreur){
    reinitialiser(); alerteOrdre.classList.remove("visible");
    afficherResultat(null, r.erreur, null);
    return;
  }
  if(typeof r.erreurOrdre === "string"){
    alerteOrdre.textContent = r.erreurOrdre;
    alerteOrdre.classList.add("visible");
    reinitialiser();
    afficherResultat(null, "—", null);
    return;
  }
  alerteOrdre.classList.remove("visible");

  if(r.totalMois === undefined){
    reinitialiser();
    afficherResultat(null, "Renseignez la date d'entrée et la date d'envoi de la lettre", null);
    return;
  }

  rAnc.textContent = formatAnciennete(r.totalMois);
  rPalier.textContent = r.dureeLegaleLabel;
  blocLibre.style.display = r.palier === "libre" ? "block" : "none";
  blocFixe.style.display = r.palier === "libre" ? "none" : "block";

  if(r.convPlusCourte){
    alerteConv.textContent = "⚠ La durée saisie est plus courte que le préavis légal minimum (" + r.dureeLegaleLabel + ") : c'est le minimum légal qui s'applique et qui est retenu dans le calcul.";
    alerteConv.classList.add("visible");
  } else {
    alerteConv.classList.remove("visible");
  }

  if(r.erreurDuree){
    alerteConges.classList.remove("visible");
    afficherResultat(null, r.erreurDuree, null);
    return;
  }
  majAlerteConges("lic-alerte-conges", r);
  let texteVide = "—";
  if(!parseDateInput(document.getElementById("lic-date-notif").value)) texteVide = "Renseignez la date de première présentation de la lettre";
  else if(r.palier === "libre") texteVide = "Indiquez la durée du préavis ci-dessus";
  afficherResultat(r.fin, texteVide, r);
}

/* ---------- Réglages initiaux ---------- */
document.getElementById("panneau-licenciement").style.display = "none";
document.getElementById("bloc-motif-licenciement").style.display = "none";
calculerTout();
</script>
