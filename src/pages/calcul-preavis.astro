<script is:inline>
/* ---------- Fonctions de date (mêmes conventions que les autres calculateurs du site) ---------- */
function ajouterMois(date, n){
  const d = new Date(date.getFullYear(), date.getMonth() + n, date.getDate());
  if(d.getDate() !== date.getDate()){
    return new Date(date.getFullYear(), date.getMonth() + n + 1, 0);
  }
  return d;
}
function veilleDe(date){
  const d = new Date(date);
  d.setDate(d.getDate() - 1);
  return d;
}
/* Préavis en mois : décompte "de date à date", expire la veille de la date anniversaire
   (règle confirmée pour le préavis par service-public.fr, fiche F2883) */
function finPreavisMois(debut, n){
  return veilleDe(ajouterMois(debut, n));
}
function ajouterJoursCalendaires(debut, n){
  const d = new Date(debut);
  d.setDate(d.getDate() + n);
  return d;
}
/* Préavis en jours calendaires : le jour de notification compte comme jour 1 */
function finPreavisJoursCalendaires(debut, n){
  return ajouterJoursCalendaires(debut, n - 1);
}
function estJourOuvre(d){
  const j = d.getDay();
  return j !== 0 && j !== 6;
}
/* Préavis en jours ouvrés : compte les jours ouvrés à partir du jour de notification
   (ce jour comptant comme jour 1 s'il est lui-même ouvré ; sinon le premier jour ouvré
   suivant devient le jour 1). Ne tient pas compte des jours fériés : aucun texte consulté
   ne fixe cette règle pour le cas générique où la durée vient d'une convention ou d'un
   contrat — c'est une méthode appliquée par cet outil à défaut de précision, signalée
   dans l'avertissement en bas de page. */
function finPreavisJoursOuvres(debut, n){
  let d = new Date(debut);
  let compte = 0;
  while(compte < n){
    if(estJourOuvre(d)) compte++;
    if(compte === n) break;
    d.setDate(d.getDate() + 1);
  }
  return d;
}
/* Jours ouvrables : tous les jours sauf le jour de repos hebdomadaire (dimanche) —
   à distinguer des jours ouvrés (lundi-vendredi uniquement). Même limite que pour
   les jours ouvrés : pas de gestion des jours fériés. */
function estJourOuvrable(d){
  return d.getDay() !== 0;
}
function finPreavisJoursOuvrables(debut, n){
  let d = new Date(debut);
  let compte = 0;
  while(compte < n){
    if(estJourOuvrable(d)) compte++;
    if(compte === n) break;
    d.setDate(d.getDate() + 1);
  }
  return d;
}
function ajouterSemaines(debut, n){
  return ajouterJoursCalendaires(debut, n * 7 - 1);
}
/* Ancienneté en mois entiers, par ajout de mois plafonné (même moteur que le calculateur
   d'ancienneté du site) : gère correctement les fins de mois sans jamais produire un
   résultat négatif ou incohérent. */
function totalMoisAnciennete(debut, fin){
  const approx = (fin.getFullYear() - debut.getFullYear()) * 12 + (fin.getMonth() - debut.getMonth());
  let totalMois = approx;
  let candidat = ajouterMois(debut, totalMois);
  if(candidat > fin){
    totalMois -= 1;
  } else {
    let suivant = ajouterMois(debut, totalMois + 1);
    while(suivant <= fin){
      totalMois += 1;
      suivant = ajouterMois(debut, totalMois + 1);
    }
  }
  return totalMois;
}
function parseDateInput(str){
  if(!str) return null;
  const [a,m,j] = str.split("-").map(Number);
  return new Date(a, m-1, j);
}
function formatDateFr(d){
  const jours = ["dimanche","lundi","mardi","mercredi","jeudi","vendredi","samedi"];
  const mois = ["janvier","février","mars","avril","mai","juin","juillet","août","septembre","octobre","novembre","décembre"];
  return jours[d.getDay()] + " " + d.getDate() + " " + mois[d.getMonth()] + " " + d.getFullYear();
}
function formatAnciennete(totalMois){
  const annees = Math.floor(totalMois / 12);
  const mois = totalMois % 12;
  const parts = [];
  if(annees > 0) parts.push(annees + (annees === 1 ? " an" : " ans"));
  parts.push(mois + (mois === 1 ? " mois" : " mois"));
  return parts.join(", ");
}

/* Calcule la date de fin à partir d'une durée saisie librement (nombre + unité +
   éventuellement calendaire/ouvré). Renvoie null tant qu'une information nécessaire
   manque : on ne calcule jamais de date "par défaut" à partir de champs incomplets. */
function calculerFinDepuisSaisie(debut, nombreStr, unite, modeJours){
  if(!debut || !unite) return null;
  const n = parseInt(nombreStr, 10);
  if(isNaN(n) || n <= 0) return null;
  if(unite === "mois") return finPreavisMois(debut, n);
  if(unite === "semaines") return ajouterSemaines(debut, n);
  if(unite === "jours"){
    if(!modeJours) return null;
    if(modeJours === "ouvres") return finPreavisJoursOuvres(debut, n);
    if(modeJours === "ouvrables") return finPreavisJoursOuvrables(debut, n);
    return finPreavisJoursCalendaires(debut, n);
  }
  return null;
}

function joursEntre(d1, d2){
  return Math.round((d2 - d1) / 86400000);
}
/* Calcule l'effet des congés payés sur la date de fin du préavis.
   Ne considère que les jours de congés qui recoupent réellement la période
   de préavis (entre le début du préavis et sa date de fin avant prolongation) :
   des congés entièrement avant ou entièrement après cette période n'ont aucun
   effet, même si le choix "oui" a été fait — on calcule le recouvrement, on ne
   fait jamais confiance à un nombre saisi à la main. */
function calculerEffetConges(debutPreavis, finNaive, congesSelect, congeDebutStr, congeFinStr){
  if(!finNaive || congesSelect !== "oui") return { fin: finNaive };
  const cd = parseDateInput(congeDebutStr);
  const cf = parseDateInput(congeFinStr);
  if(!cd || !cf) return { fin: finNaive };
  if(cf < cd) return { fin: finNaive, erreurOrdre: true };
  const overlapDebut = cd > debutPreavis ? cd : debutPreavis;
  const overlapFin = cf < finNaive ? cf : finNaive;
  if(overlapDebut > overlapFin) return { fin: finNaive, horsPeriode: true };
  const chevauchement = joursEntre(overlapDebut, overlapFin) + 1;
  return { fin: ajouterJoursCalendaires(finNaive, chevauchement), congesAppliques: true, chevauchement };
}

function detecterBadInput(...inputs){
  return inputs.some(i => i && i.validity && i.validity.badInput);
}

/* ---------- État ---------- */
let typeRupture = "demission";

/* ---------- Câblage : type de rupture ---------- */
document.querySelectorAll("#type-rupture .seg-btn").forEach(b => b.addEventListener("click", () => {
  typeRupture = b.dataset.type;
  document.querySelectorAll("#type-rupture .seg-btn").forEach(x => x.classList.toggle("active", x === b));
  document.getElementById("bloc-motif-licenciement").style.display = typeRupture === "licenciement" ? "block" : "none";
  document.getElementById("panneau-demission").style.display = typeRupture === "demission" ? "block" : "none";
  document.getElementById("panneau-licenciement").style.display = typeRupture === "licenciement" ? "block" : "none";
  calculerTout();
}));

/* ---------- Câblage : sous-champs conditionnels ---------- */
function cablerUnite(idUnite, idModeWrap){
  document.getElementById(idUnite).addEventListener("change", function(){
    document.getElementById(idModeWrap).style.display = this.value === "jours" ? "flex" : "none";
    calculerTout();
  });
}
cablerUnite("dem-unite", "dem-mode-jours-wrap");
cablerUnite("lic-unite-libre", "lic-mode-jours-libre-wrap");
cablerUnite("lic-unite-conv", "lic-mode-jours-conv-wrap");

function cablerConges(idSelect, idDatesWrap, idHint){
  document.getElementById(idSelect).addEventListener("change", function(){
    const show = this.value === "oui";
    document.getElementById(idDatesWrap).style.display = show ? "flex" : "none";
    document.getElementById(idHint).style.display = show ? "block" : "none";
    calculerTout();
  });
}
cablerConges("dem-conges-select", "dem-conges-dates-wrap", "dem-hint-conges");
cablerConges("lic-conges-select", "lic-conges-dates-wrap", "lic-hint-conges");

document.getElementById("faute-grave").addEventListener("change", calculerTout);
document.getElementById("lic-convention-check").addEventListener("change", function(){
  document.getElementById("lic-convention-wrap").style.display = this.checked ? "flex" : "none";
  calculerTout();
});

["dem-date-notif","dem-duree","dem-unite","dem-mode-jours","dem-conges-select","dem-conges-debut","dem-conges-fin"].forEach(id => {
  const el = document.getElementById(id);
  el.addEventListener("change", calculerTout);
  el.addEventListener("input", calculerTout);
});
["lic-date-entree","lic-date-notif","lic-duree-libre","lic-unite-libre","lic-mode-jours-libre",
 "lic-duree-conv","lic-unite-conv","lic-mode-jours-conv","lic-conges-select","lic-conges-debut","lic-conges-fin"].forEach(id => {
  const el = document.getElementById(id);
  el.addEventListener("change", calculerTout);
  el.addEventListener("input", calculerTout);
});

/* ---------- Calcul : bloc démission ---------- */
function calculerDemission(){
  const inpDate = document.getElementById("dem-date-notif");
  if(detecterBadInput(inpDate)){
    return { erreur: "Date invalide : vérifiez que le jour saisi existe bien dans le mois choisi." };
  }
  const debut = parseDateInput(inpDate.value);
  const unite = document.getElementById("dem-unite").value;
  const modeJours = document.getElementById("dem-mode-jours").value;
  const nombre = document.getElementById("dem-duree").value;

  const finNaive = calculerFinDepuisSaisie(debut, nombre, unite, modeJours);
  if(!finNaive) return { fin: null };

  const congesSelect = document.getElementById("dem-conges-select").value;
  const inpCd = document.getElementById("dem-conges-debut");
  const inpCf = document.getElementById("dem-conges-fin");
  if(congesSelect === "oui" && detecterBadInput(inpCd, inpCf)){
    return { fin: finNaive, congesErreur: "Date de congés invalide : vérifiez que le jour saisi existe bien dans le mois choisi." };
  }
  const c = calculerEffetConges(debut, finNaive, congesSelect, inpCd.value, inpCf.value);
  return { fin: c.fin, congesAppliques: !!c.congesAppliques, congesHorsPeriode: !!c.horsPeriode, congesErreurOrdre: !!c.erreurOrdre, chevauchement: c.chevauchement };
}

/* ---------- Calcul : bloc licenciement ---------- */
function calculerLicenciement(){
  const fauteGrave = document.getElementById("faute-grave").value;
  if(fauteGrave === "oui") return { fauteGrave: true };
  if(!fauteGrave) return { motifNonChoisi: true };

  const inpEntree = document.getElementById("lic-date-entree");
  const inpNotif = document.getElementById("lic-date-notif");
  if(detecterBadInput(inpEntree, inpNotif)){
    return { erreur: "Date invalide : vérifiez que le jour saisi existe bien dans le mois choisi." };
  }
  const entree = parseDateInput(inpEntree.value);
  const notif = parseDateInput(inpNotif.value);
  if(!entree || !notif) return { anciennete: null };
  if(notif < entree) return { erreurOrdre: true };

  const totalMois = totalMoisAnciennete(entree, notif);
  let palier, dureeLegaleLabel;
  if(totalMois < 6){
    palier = "libre";
    dureeLegaleLabel = "Non fixé par la loi";
  } else if(totalMois < 24){
    palier = "un_mois";
    dureeLegaleLabel = "1 mois";
  } else {
    palier = "deux_mois";
    dureeLegaleLabel = "2 mois";
  }

  let finNaive = null;
  if(palier === "libre"){
    const nombre = document.getElementById("lic-duree-libre").value;
    const unite = document.getElementById("lic-unite-libre").value;
    const modeJours = document.getElementById("lic-mode-jours-libre").value;
    finNaive = calculerFinDepuisSaisie(notif, nombre, unite, modeJours);
  } else {
    const legalN = palier === "un_mois" ? 1 : 2;
    finNaive = finPreavisMois(notif, legalN);
    if(document.getElementById("lic-convention-check").checked){
      const nombre = document.getElementById("lic-duree-conv").value;
      const unite = document.getElementById("lic-unite-conv").value;
      const modeJours = document.getElementById("lic-mode-jours-conv").value;
      const finConv = calculerFinDepuisSaisie(notif, nombre, unite, modeJours);
      if(finConv) finNaive = finConv;
    }
  }

  const congesSelect = document.getElementById("lic-conges-select").value;
  const inpCd = document.getElementById("lic-conges-debut");
  const inpCf = document.getElementById("lic-conges-fin");
  if(!finNaive){
    return { totalMois, palier, dureeLegaleLabel, fin: null };
  }
  if(congesSelect === "oui" && detecterBadInput(inpCd, inpCf)){
    return { totalMois, palier, dureeLegaleLabel, fin: finNaive, congesErreur: "Date de congés invalide : vérifiez que le jour saisi existe bien dans le mois choisi." };
  }
  const c = calculerEffetConges(notif, finNaive, congesSelect, inpCd.value, inpCf.value);

  return { totalMois, palier, dureeLegaleLabel, fin: c.fin, congesAppliques: !!c.congesAppliques, congesHorsPeriode: !!c.horsPeriode, congesErreurOrdre: !!c.erreurOrdre, chevauchement: c.chevauchement };
}

/* ---------- Affichage ---------- */
function afficherResultat(fin, texteVide, conges){
  const el = document.getElementById("r-date-fin");
  const noteConges = document.getElementById("note-conges");
  if(!fin){
    el.textContent = texteVide;
    el.classList.add("vide");
    noteConges.style.display = "none";
    return;
  }
  el.textContent = formatDateFr(fin);
  el.classList.remove("vide");
  if(conges && conges.appliques){
    noteConges.innerHTML = "Cette date intègre " + conges.chevauchement + " jour(s) de congés payés qui recoupent la période de préavis : le préavis a été prolongé d'autant (il est suspendu pendant les congés, puis reprend à leur issue). Si vos congés ont été posés <b>après</b> la notification, d'un commun accord, ils ne suspendent pas le préavis — la date ci-dessus ne s'applique alors pas.";
    noteConges.style.display = "block";
  } else if(conges && conges.horsPeriode){
    noteConges.textContent = "Les congés indiqués ne recoupent pas la période de préavis (ni avant, ni pendant) : ils n'ont donc aucun effet sur la date de fin ci-dessus.";
    noteConges.style.display = "block";
  } else {
    noteConges.style.display = "none";
  }
}

function majAlerteConges(id, r){
  const el = document.getElementById(id);
  if(r.congesErreur){
    el.textContent = "⚠ " + r.congesErreur;
    el.classList.add("visible");
  } else if(r.congesErreurOrdre){
    el.textContent = "⚠ La date de fin des congés est antérieure à la date de début. Vérifiez les dates saisies.";
    el.classList.add("visible");
  } else {
    el.classList.remove("visible");
  }
}

function calculerTout(){
  const alerteFaute = document.getElementById("alerte-faute-grave");
  const rLbl = document.getElementById("r-lbl");
  rLbl.textContent = "Le préavis se termine le";

  if(typeRupture === "demission"){
    alerteFaute.classList.remove("visible");
    document.getElementById("lic-alerte-dates").classList.remove("visible");
    const r = calculerDemission();
    if(r.erreur){
      document.getElementById("dem-alerte-conges").classList.remove("visible");
      afficherResultat(null, r.erreur, null);
      return;
    }
    majAlerteConges("dem-alerte-conges", r);
    afficherResultat(r.fin, "Complétez la date, la durée et l'unité du préavis", { appliques: r.congesAppliques, horsPeriode: r.congesHorsPeriode, chevauchement: r.chevauchement });
    return;
  }

  /* --- Licenciement --- */
  const rAnc = document.getElementById("lic-r-anciennete");
  const rPalier = document.getElementById("lic-r-palier");
  const blocLibre = document.getElementById("lic-bloc-libre");
  const blocFixe = document.getElementById("lic-bloc-fixe");
  const licCorps = document.getElementById("lic-corps");
  const alerteOrdre = document.getElementById("lic-alerte-dates");

  const r = calculerLicenciement();

  if(r.fauteGrave){
    alerteFaute.classList.add("visible");
    licCorps.style.display = "none";
    afficherResultat(null, "Aucun préavis n'est dû", null);
    return;
  }
  alerteFaute.classList.remove("visible");
  licCorps.style.display = "block";

  if(r.motifNonChoisi){
    rAnc.textContent = "—"; rPalier.textContent = "—";
    blocLibre.style.display = "none"; blocFixe.style.display = "none";
    alerteOrdre.classList.remove("visible");
    document.getElementById("lic-alerte-conges").classList.remove("visible");
    afficherResultat(null, "Choisissez d'abord le motif du licenciement", null);
    return;
  }
  if(r.erreur){
    rAnc.textContent = "—"; rPalier.textContent = "—";
    blocLibre.style.display = "none"; blocFixe.style.display = "none";
    afficherResultat(null, r.erreur, null);
    return;
  }
  if(r.erreurOrdre){
    alerteOrdre.textContent = "⚠ La date d'entrée est postérieure à la date de notification. Vérifiez les dates saisies.";
    alerteOrdre.classList.add("visible");
    rAnc.textContent = "—"; rPalier.textContent = "—";
    blocLibre.style.display = "none"; blocFixe.style.display = "none";
    document.getElementById("lic-alerte-conges").classList.remove("visible");
    afficherResultat(null, "—", null);
    return;
  }
  alerteOrdre.classList.remove("visible");

  if(r.totalMois === undefined){
    rAnc.textContent = "—"; rPalier.textContent = "—";
    blocLibre.style.display = "none"; blocFixe.style.display = "none";
    document.getElementById("lic-alerte-conges").classList.remove("visible");
    afficherResultat(null, "Renseignez les deux dates", null);
    return;
  }

  rAnc.textContent = formatAnciennete(r.totalMois);
  rPalier.textContent = r.dureeLegaleLabel;
  blocLibre.style.display = r.palier === "libre" ? "block" : "none";
  blocFixe.style.display = r.palier === "libre" ? "none" : "block";
  majAlerteConges("lic-alerte-conges", r);
  afficherResultat(r.fin, r.palier === "libre" ? "Indiquez la durée du préavis ci-dessus" : "—", { appliques: r.congesAppliques, horsPeriode: r.congesHorsPeriode, chevauchement: r.chevauchement });
}

/* ---------- Réglages initiaux ---------- */
document.getElementById("panneau-licenciement").style.display = "none";
document.getElementById("bloc-motif-licenciement").style.display = "none";
calculerTout();
</script>
</body>
</html>
