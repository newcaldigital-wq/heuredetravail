<script is:inline>
const DATA={};

function toMin(v){
  if(v==null||v==="")return null;
  const m=String(v).trim().match(/^(\d{1,2}):(\d{2})$/);
  if(!m)return null;
  return (+m[1])*60+(+m[2]);
}
function decHM(d){if(isNaN(d)||d===null)return"";let h=Math.floor(d+1e-9),m=Math.round((d-h)*60);if(m===60){h++;m=0;}return h+"h"+String(m).padStart(2,"0");}
function decFr(d){return d.toFixed(2).replace(".",",");}
function cleJour(dt){return dt.getFullYear()+"-"+String(dt.getMonth()+1).padStart(2,"0")+"-"+String(dt.getDate()).padStart(2,"0");}

/* Instance de plage nocturne ancrée sur un jour donné (minuit de ce jour).
   Si neMin <= nsMin, la plage traverse minuit (cas normal, ex. 21h->6h).
   Sinon (cas atypique), la plage ne traverse pas minuit. */
function instanceNuit(jourAncre,nsMin,neMin){
  const debut=new Date(jourAncre);debut.setHours(0,0,0,0);debut.setMinutes(nsMin);
  const fin=new Date(jourAncre);fin.setHours(0,0,0,0);
  if(neMin<=nsMin){fin.setDate(fin.getDate()+1);}
  fin.setMinutes(fin.getMinutes()+neMin);
  return [debut,fin];
}
/* Intervalle du poste : ancré sur "jour" (jour de début).
   Si fin <= début, le poste traverse minuit (se termine le lendemain). */
function intervallePoste(jour,debutStr,finStr){
  const s=toMin(debutStr),e=toMin(finStr);
  if(s==null||e==null)return null;
  const debut=new Date(jour);debut.setHours(0,0,0,0);debut.setMinutes(s);
  const fin=new Date(jour);fin.setHours(0,0,0,0);
  if(e<=s){fin.setDate(fin.getDate()+1);}
  fin.setMinutes(fin.getMinutes()+e);
  return [debut,fin];
}
function overlapMs(aS,aE,bS,bE){const s=Math.max(aS,bS),e=Math.min(aE,bE);return Math.max(0,e-s);}

/* Heures de nuit d'un poste : on compare le poste aux instances de plage nocturne
   ancrées sur la veille, le jour même, et le lendemain, pour ne rien manquer
   ni double-compter (les instances successives ne se chevauchent jamais). */
function heuresNuitPoste(jour,debutStr,finStr,nsMin,neMin){
  const poste=intervallePoste(jour,debutStr,finStr);
  if(!poste)return 0;
  const [pS,pE]=poste;
  let total=0;
  for(let off=-1;off<=1;off++){
    const ancre=new Date(jour);ancre.setDate(ancre.getDate()+off);
    const [nS,nE]=instanceNuit(ancre,nsMin,neMin);
    total+=overlapMs(pS.getTime(),pE.getTime(),nS.getTime(),nE.getTime());
  }
  return total/3600000;
}

const MOIS=["Janvier","Février","Mars","Avril","Mai","Juin","Juillet","Août","Septembre","Octobre","Novembre","Décembre"];
const JOURS=["lun","mar","mer","jeu","ven","sam","dim"];
const selMois=document.getElementById("mois");
MOIS.forEach((m,i)=>{const o=document.createElement("option");o.value=i;o.textContent=m;selMois.appendChild(o);});
const now=new Date();selMois.value=now.getMonth();document.getElementById("annee").value=now.getFullYear();

function plageNuit(){
  return {ns:toMin(document.getElementById("ns").value)??1260, ne:toMin(document.getElementById("ne").value)??360};
}

function sauveLigne(tr){
  const k=tr.dataset.date;
  DATA[k]={d1:tr.querySelector(".d1").value,d2:tr.querySelector(".d2").value};
  calculerLigne(tr);
  calculer();
}
function calculerLigne(tr){
  const k=tr.dataset.date,jour=new Date(k+"T00:00:00"),rec=DATA[k]||{};
  const {ns,ne}=plageNuit();
  const h=heuresNuitPoste(jour,rec.d1,rec.d2,ns,ne);
  tr.querySelector("[data-h]").textContent=(rec.d1&&rec.d2&&h>=0)?decHM(h)+" ("+decFr(h)+" h)":"—";
}
function ligneHTML(date){
  const jw=(date.getDay()+6)%7,k=cleJour(date),rec=DATA[k]||{};
  const cls=jw>=5?"we":"";
  return '<tr class="'+cls+'" data-date="'+k+'">'
    +'<td class="date">'+String(date.getDate()).padStart(2,"0")+"/"+String(date.getMonth()+1).padStart(2,"0")+'</td>'
    +'<td class="jour">'+JOURS[jw]+'</td>'
    +'<td><input type="time" class="d1" value="'+(rec.d1||"")+'"></td>'
    +'<td><input type="time" class="d2" value="'+(rec.d2||"")+'"></td>'
    +'<td class="htot" data-h>—</td></tr>';
}
function construire(){
  const mois=+selMois.value,annee=+document.getElementById("annee").value;
  const dernier=new Date(annee,mois+1,0);
  let html="";
  for(let d=1;d<=dernier.getDate();d++)html+=ligneHTML(new Date(annee,mois,d));
  const corps=document.getElementById("corps");corps.innerHTML=html;
  corps.querySelectorAll("tr").forEach(tr=>calculerLigne(tr));
  corps.querySelectorAll("input").forEach(inp=>{
    inp.addEventListener("input",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("change",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("blur",()=>sauveLigne(inp.closest("tr")));
  });
}
function calculer(){
  const mois=+selMois.value,annee=+document.getElementById("annee").value;
  const dernier=new Date(annee,mois+1,0);
  const {ns,ne}=plageNuit();
  let total=0;
  for(let d=1;d<=dernier.getDate();d++){
    const jour=new Date(annee,mois,d),k=cleJour(jour),rec=DATA[k]||{};
    total+=heuresNuitPoste(jour,rec.d1,rec.d2,ns,ne);
  }
  document.getElementById("r-tot").innerHTML=decFr(total)+'<small> h · '+decHM(total)+'</small>';
}
function exemple(){
  const mois=+selMois.value,annee=+document.getElementById("annee").value,nb=new Date(annee,mois+1,0).getDate();
  for(let d=1;d<=nb;d++){const dt=new Date(annee,mois,d),jw=(dt.getDay()+6)%7;if(jw<5)DATA[cleJour(dt)]={d1:"20:00",d2:"04:00"};}
  construire();calculer();
}
function vider(){
  const mois=+selMois.value,annee=+document.getElementById("annee").value,nb=new Date(annee,mois+1,0).getDate();
  for(let d=1;d<=nb;d++)delete DATA[cleJour(new Date(annee,mois,d))];
  construire();
  document.getElementById("r-tot").innerHTML='0<small> h</small>';
}
function changeMois(delta){
  let m=+selMois.value+delta,y=+document.getElementById("annee").value;
  if(m<0){m=11;y--;}else if(m>11){m=0;y++;}
  selMois.value=m;document.getElementById("annee").value=y;construire();calculer();
}
selMois.addEventListener("change",()=>{construire();calculer();});
document.getElementById("annee").addEventListener("change",()=>{construire();calculer();});
document.getElementById("prev").addEventListener("click",()=>changeMois(-1));
document.getElementById("next").addEventListener("click",()=>changeMois(1));
document.getElementById("calculer").addEventListener("click",calculer);
document.getElementById("exemple").addEventListener("click",exemple);
document.getElementById("vider").addEventListener("click",vider);
document.getElementById("ns").addEventListener("change",()=>{construire();calculer();});
document.getElementById("ne").addEventListener("change",()=>{construire();calculer();});
document.getElementById("reinit").addEventListener("click",()=>{
  document.getElementById("ns").value="21:00";
  document.getElementById("ne").value="06:00";
  construire();calculer();
});
construire();calculer();
</script>
</body>
</html>
