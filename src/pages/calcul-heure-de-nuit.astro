</div>

<script is:inline>
/* Compteur d'heures de nuit, poste par poste, rattaché à son jour de début (convention de l'outil).
   - Calcul en heures d'horloge sur des numéros de jour UTC : aucun recours au fuseau horaire de
     l'appareil (résultat identique partout dans le monde).
   - Changement d'heure (convention de l'outil, aucun texte spécifique ; principe du temps de travail
     effectif = temps réellement écoulé) : par défaut, heure légale de métropole. Dernier dimanche de
     mars : l'intervalle d'horloge 2 h - 3 h n'existe pas (retiré). Dernier dimanche d'octobre :
     l'intervalle 2 h - 3 h existe deux fois ; un poste commence au premier passage et se termine au
     second (1 h ajoutée dès que la plage comptée touche cet intervalle). Case « pas de changement
     d'heure » : heures d'horloge seules.
   - Plage par défaut 21 h - 6 h (L3122-20) ; cadre L3122-2 (9 h consécutives, 0 h - 5 h incluses,
     entre 21 h et 7 h), 7 h dans les secteurs dérogatoires (L3122-3, L3122-4) : contrôle et alerte. */
const DATA={};
const J=1440;

function toMin(v){
  if(v==null||v==="")return null;
  const m=String(v).trim().match(/^(\d{1,2}):(\d{2})$/);
  if(!m)return null;
  return (+m[1])*60+(+m[2]);
}
function decHM(d){if(isNaN(d)||d===null)return"";let h=Math.floor(d+1e-9),m=Math.round((d-h)*60);if(m===60){h++;m=0;}return h+"h"+String(m).padStart(2,"0");}
function decPt(d){return d.toFixed(2);}
function cleJour(y,m,d){return y+"-"+String(m+1).padStart(2,"0")+"-"+String(d).padStart(2,"0");}
function numJour(y,m,d){return Math.round(Date.UTC(y,m,d)/86400000);}
function dimancheDernier(y,m){const d=new Date(Date.UTC(y,m+1,0));return numJour(y,m,d.getUTCDate()-d.getUTCDay());}
function chevauche(a,b,c,d){return Math.max(0,Math.min(b,d)-Math.max(a,c));}

/* Ajustement « temps réel » d'un intervalle d'horloge [a,b] (minutes absolues), heure de métropole. */
function ajustDST(a,b){
  let adj=0;
  const y0=new Date(Math.floor(a/J)*86400000).getUTCFullYear();
  for(let y=y0-1;y<=y0+1;y++){
    const mars=dimancheDernier(y,2)*J, oct=dimancheDernier(y,9)*J;
    adj-=chevauche(a,b,mars+120,mars+180);
    if(a<oct+180&&b>oct+120)adj+=60;
  }
  return adj;
}

/* Heures de nuit d'un poste commencant le jour n (numéro de jour). Renvoie {h, err, dst}. */
function heuresNuitPoste(n,debutStr,finStr,ns,ne,avecDST){
  const s=toMin(debutStr),e=toMin(finStr);
  if(s==null&&e==null)return {h:0,err:null,dst:0};
  if(s==null||e==null)return {h:0,err:"incomplet",dst:0};
  if(s===e)return {h:0,err:"egal",dst:0};
  const pS=n*J+s,pE=n*J+e+(e<s?J:0);
  let total=0,dst=0;
  for(let off=-1;off<=1;off++){
    const a=(n+off)*J;
    const nS=a+ns,nE=a+ne+(ne<=ns?J:0);
    const iS=Math.max(pS,nS),iE=Math.min(pE,nE);
    if(iE>iS){
      const adj=avecDST?ajustDST(iS,iE):0;
      total+=iE-iS+adj;dst+=adj;
    }
  }
  return {h:total/60,err:null,dst:dst/60};
}

/* Contrôle de la plage au regard de L3122-2 / L3122-3 / L3122-4. */
function etatPlage(ns,ne){
  if(ns==null||ne==null)return "vide";
  if(ns===ne)return "nulle";
  const traverse=ne<ns;
  const duree=traverse?J-ns+ne:ne-ns;
  const inclut=traverse?ne>=300:(ns===0&&ne>=300);
  const bornes=(traverse?ns>=1260:ns===0)&&ne<=420;
  if(!inclut||!bornes||duree<420)return "hors";
  if(duree<540)return "derog";
  return "ok";
}

const MOIS=["Janvier","Février","Mars","Avril","Mai","Juin","Juillet","Août","Septembre","Octobre","Novembre","Décembre"];
const JOURS=["lun","mar","mer","jeu","ven","sam","dim"];
const selMois=document.getElementById("mois"),inAnnee=document.getElementById("annee");
MOIS.forEach((m,i)=>{const o=document.createElement("option");o.value=i;o.textContent=m;selMois.appendChild(o);});
const now=new Date();selMois.value=now.getMonth();inAnnee.value=now.getFullYear();

function anneeValide(){const v=String(inAnnee.value).trim();const n=Number(v);return (v!==""&&Number.isInteger(n)&&n>=2000&&n<=2100)?n:null;}
function plageNuit(){return {ns:toMin(document.getElementById("ns").value),ne:toMin(document.getElementById("ne").value)};}
function avecDST(){return !document.getElementById("sansdst").checked;}

function cellule(y,m,d){
  const k=cleJour(y,m,d),rec=DATA[k]||{},{ns,ne}=plageNuit(),ep=etatPlage(ns,ne);
  if(ep==="vide"||ep==="nulle")return {txt:"—",r:null};
  const r=heuresNuitPoste(numJour(y,m,d),rec.d1,rec.d2,ns,ne,avecDST());
  if(r.err)return {txt:"⚠",r};
  if(!rec.d1)return {txt:"—",r};
  return {txt:decHM(r.h)+" ("+decPt(r.h)+" h)"+(r.dst?(r.dst<0?" · 1 h de moins":" · 1 h de plus"):""),r};
}
function sauveLigne(tr){
  DATA[tr.dataset.date]={d1:tr.querySelector(".d1").value,d2:tr.querySelector(".d2").value};
  calculer();
}
function ligneHTML(y,m,d){
  const date=new Date(Date.UTC(y,m,d)),jw=(date.getUTCDay()+6)%7,k=cleJour(y,m,d),rec=DATA[k]||{};
  const dd=String(d).padStart(2,"0")+"/"+String(m+1).padStart(2,"0");
  return '<tr class="'+(jw>=5?"we":"")+'" data-date="'+k+'" data-d="'+d+'">'
    +'<td class="date">'+dd+'</td>'
    +'<td class="jour">'+JOURS[jw]+'</td>'
    +'<td><input type="time" class="d1" aria-label="Début du poste le '+dd+'" value="'+(rec.d1||"")+'"></td>'
    +'<td><input type="time" class="d2" aria-label="Fin du poste le '+dd+'" value="'+(rec.d2||"")+'"></td>'
    +'<td class="htot" data-h>—</td></tr>';
}
function construire(){
  const y=anneeValide();
  document.getElementById("err-annee").hidden=y!==null;
  const corps=document.getElementById("corps");
  if(y===null){corps.innerHTML="";return;}
  const m=+selMois.value,nb=new Date(Date.UTC(y,m+1,0)).getUTCDate();
  let html="";
  for(let d=1;d<=nb;d++)html+=ligneHTML(y,m,d);
  corps.innerHTML=html;
  corps.querySelectorAll("input").forEach(inp=>{
    inp.addEventListener("input",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("change",()=>sauveLigne(inp.closest("tr")));
    inp.addEventListener("blur",()=>sauveLigne(inp.closest("tr")));
  });
}
function calculer(){
  const box=document.getElementById("alertes"),msgs=[];
  const {ns,ne}=plageNuit(),ep=etatPlage(ns,ne);
  if(ep==="vide")msgs.push("Indiquez le début et la fin de la plage de nuit.");
  if(ep==="nulle")msgs.push("La plage de nuit commence et finit à la même heure : corrigez-la.");
  if(ep==="hors")msgs.push("Cette plage ne respecte pas le cadre légal : au moins 9 heures consécutives entre 21 h et 7 h, incluant minuit – 5 h (7 heures dans certains secteurs). Le calcul est fait quand même : vérifiez votre accord.");
  if(ep==="derog")msgs.push("Plage de moins de 9 heures : elle n'est possible que dans les secteurs dérogatoires (presse, audiovisuel, spectacles, discothèques, commerces en zone touristique internationale).");
  const y=anneeValide(),out=document.getElementById("r-tot");
  if(y===null||ep==="vide"||ep==="nulle"){
    document.querySelectorAll("#corps [data-h]").forEach(td=>td.textContent="—");
    out.innerHTML='—<small> h</small>';
  }else{
    const m=+selMois.value;let total=0;
    document.querySelectorAll("#corps tr").forEach(tr=>{
      const d=+tr.dataset.d,c=cellule(y,m,d),dd=String(d).padStart(2,"0")+"/"+String(m+1).padStart(2,"0");
      tr.querySelector("[data-h]").textContent=c.txt;
      if(c.r){
        if(c.r.err==="incomplet")msgs.push(dd+" : début ou fin du poste manquant. Ce poste n'est pas compté.");
        else if(c.r.err==="egal")msgs.push(dd+" : le poste commence et finit à la même heure. Ce poste n'est pas compté (un poste de 24 h ou plus ne peut pas être saisi).");
        else{total+=c.r.h;if(c.r.dst)msgs.push(dd+" : nuit du changement d'heure en métropole, "+(c.r.dst<0?"1 h de moins":"1 h de plus")+" comptée (temps réellement écoulé). Cochez « Pas de changement d'heure » si vous travaillez en outre-mer.");}
      }
    });
    out.innerHTML=decPt(total)+'<small> h · '+decHM(total)+'</small>';
  }
  box.hidden=msgs.length===0;
  box.innerHTML=msgs.length?"<b>À vérifier</b><ul>"+msgs.map(t=>"<li>"+t+"</li>").join("")+"</ul>":"";
}
function exemple(){
  const y=anneeValide();if(y===null)return;
  const m=+selMois.value,nb=new Date(Date.UTC(y,m+1,0)).getUTCDate();
  for(let d=1;d<=nb;d++){const jw=(new Date(Date.UTC(y,m,d)).getUTCDay()+6)%7;if(jw<5)DATA[cleJour(y,m,d)]={d1:"20:00",d2:"04:00"};}
  construire();calculer();
}
function vider(){
  const y=anneeValide();if(y===null)return;
  const m=+selMois.value,nb=new Date(Date.UTC(y,m+1,0)).getUTCDate();
  for(let d=1;d<=nb;d++)delete DATA[cleJour(y,m,d)];
  construire();calculer();
}
function changeMois(delta){
  let m=+selMois.value+delta,y=anneeValide();if(y===null)y=now.getFullYear();
  if(m<0){m=11;y--;}else if(m>11){m=0;y++;}
  selMois.value=m;inAnnee.value=y;construire();calculer();
}
selMois.addEventListener("change",()=>{construire();calculer();});
inAnnee.addEventListener("change",()=>{construire();calculer();});
document.getElementById("prev").addEventListener("click",()=>changeMois(-1));
document.getElementById("next").addEventListener("click",()=>changeMois(1));
document.getElementById("calculer").addEventListener("click",calculer);
document.getElementById("exemple").addEventListener("click",exemple);
document.getElementById("vider").addEventListener("click",vider);
["ns","ne"].forEach(id=>{document.getElementById(id).addEventListener("change",calculer);document.getElementById(id).addEventListener("input",calculer);});
document.getElementById("sansdst").addEventListener("change",calculer);
document.getElementById("reinit").addEventListener("click",()=>{
  document.getElementById("ns").value="21:00";
  document.getElementById("ne").value="06:00";
  calculer();
});
construire();calculer();
</script>
</body>
</html>
